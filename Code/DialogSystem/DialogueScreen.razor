@using Sandbox;
@using Sandbox.UI;
@namespace Sinvest
@inherits PanelComponent
@implements IDialogueUI

<root class="dialogue-overlay">
	<div class="dialogue-box">
		<label class="speaker">@Speaker</label>
		<label class="message">@Message</label>
	</div>
</root>

<style>
    .dialogue-overlay {
        position: absolute;
        width: 100%;
        height: 100%;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 50px;
        transition: all 0.3s ease;
    }

    .dialogue-box {
        width: 70%;
        min-height: 150px;
        background-color: #d1d1d1;
        border: 2px solid #444444;
        border-radius: 8px;
        flex-direction: column;
        padding: 20px;
    }

    .speaker {
        font-size: 24px;
        font-weight: bold;
        color: #222222;
        margin-bottom: 10px;
    }

    .message {
        font-size: 20px;
        color: #111111;
    }
</style>

@code {
	public string Speaker { get; set; }
	public string Message { get; set; }

	public void UpdateDialogue( string name, string text )
	{
		Speaker = name;
		Message = text;
		StateHasChanged();
	}
}
