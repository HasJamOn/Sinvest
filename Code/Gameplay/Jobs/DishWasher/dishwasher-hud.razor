@using Sandbox;
@using Sinvest;
@using Sandbox.UI;
@using System;
@namespace Sinvest
@inherits PanelComponent

<root class="dishwasher-hud">
    <div class="progress-container">
       <div class="label">PLATE CLEANLINESS</div>
       <div class="bar-background">
          <div class="bar-fill" style="width: @(CleanPercentage)%; background-color: @GetBarColor()"></div>
       </div>
       <div class="percentage-text">@Math.Floor(CleanPercentage)%</div>
    </div>
</root>

@code {
    [Property] public DishwasherDirtManager Target { get; set; }

    private float CleanPercentage => Target?.CleanPercentage ?? 0f;

    private string GetBarColor()
    {
       if ( CleanPercentage > 90f ) return "rgba(76, 217, 100, 0.9)"; // Success Green
       return "rgba(0, 200, 255, 0.9)"; // Scrubbing Blue
    }

    // Hash ensures the UI re-renders. Added RealTime.Now to force updates while debugging.
    protected override int BuildHash() => System.HashCode.Combine( RealTime.Now, CleanPercentage );
} @* <--- Added this missing brace *@

<style>
    .dishwasher-hud {
        position: absolute;
        bottom: 50px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        pointer-events: none; 
    }

    .progress-container {
        width: 400px;
        flex-direction: column;
        align-items: center;
    }

    .label {
        color: rgba(255, 255, 255, 0.8);
        font-size: 14px;
        font-weight: bold;
        box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    }

    .bar-background {
        width: 100%;
        height: 24px;
        background-color: rgba(0, 0, 0, 0.6);
        border: 2px solid rgba(255, 255, 255, 0.1);
        margin-top: 10px;
        margin-bottom: 5px;
        border-radius: 4px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        transition: width 0.2s ease-in-out, background-color 0.5s ease; 
    }

    .percentage-text {
        color: rgba(255, 255, 255, 0.9);
        font-family: monospace;
        font-size: 18px;
        font-weight: bold;
    }
</style>
