@using Sandbox; 
using Sinvest;
@using Sandbox.UI;
@using System;

@inherits Panel

<root>
    <div class="header">
        <label class="title">NEW CAREER: SLOT @SlotIndex</label>
    </div>

    <div class="body">
        <div class="field">
            <label class="field-label">LEGAL NAME</label>
            <TextEntry Value:bind=@CharName placeholder="Enter name..." />
        </div>

        <div class="modifiers-section">
            <label class="field-label">SELECT STARTING MODIFIERS</label>
            <div class="mod-list">
                @foreach ( StartingModifiers mod in Enum.GetValues( typeof( StartingModifiers ) ) )
                {
                    if ( mod == StartingModifiers.None ) continue;
                    var unlocked = SaveManager?.IsModifierUnlocked( mod ) ?? false;
                    
                    <div class="mod-row @(unlocked ? "" : "locked")" onclick=@(() => ToggleMod(mod))>
                        <label class="mod-name">@mod</label>
                        <label class="mod-status">@(ActiveMods.HasFlag(mod) ? "SELECTED" : unlocked ? "AVAILABLE" : "LOCKED")</label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="footer">
	    <button class="btn-abort @(IsProcessing ? "disabled" : "")" 
	            onclick=@(() => { if(!IsProcessing) OnCancel?.Invoke(); })>
		    ABORT
	    </button>
    
	    <button class="btn-start @(IsProcessing ? "processing" : "")" 
	            onclick=@OnConfirm 
	            disabled=@IsProcessing>
		    @(IsProcessing ? "SYNCING WITH CLOUD..." : "START CAREER")
	    </button>
    </div>
</root>

@code {
	[Property] public GameSaveSystem SaveManager { get; set; }
	[Property] public int SlotIndex { get; set; }
	public Action OnCancel { get; set; }
	public Action<string, StartingModifiers> OnCreate { get; set; }

	string CharName = "";
	StartingModifiers ActiveMods = StartingModifiers.None;
    
	// --- NEW STATE ---
	bool IsProcessing = false;
    
	protected override void OnParametersSet()
	{
		if ( SaveManager == null ) return;
		if ( !SaveManager.HasGraduated() ) ActiveMods |= StartingModifiers.MentorDad;
	}

	void ToggleMod( StartingModifiers mod ) 
	{
		if ( IsProcessing || SaveManager == null ) return; // Block input while saving
		if ( !SaveManager.IsModifierUnlocked( mod ) ) return;
		if ( mod == StartingModifiers.MentorDad && !SaveManager.HasGraduated() ) return; 

		if ( ActiveMods.HasFlag( mod ) ) ActiveMods &= ~mod;
		else ActiveMods |= mod;
	}

	async void OnConfirm() 
	{
		if ( IsProcessing || string.IsNullOrWhiteSpace( CharName ) ) return;

		IsProcessing = true;
		StateHasChanged();

		try 
		{
			// We invoke the action and WAIT for it to finish 
			// (Ensure your CharacterSelect.razor's CreateAndStart is also async/await)
			if ( OnCreate != null )
			{
				OnCreate.Invoke( CharName, ActiveMods );
			}
		}
		catch ( Exception e )
		{
			Log.Error( $"Failed to create character: {e.Message}" );
			IsProcessing = false; // Re-enable if it fails
			StateHasChanged();
		}
	}
}
