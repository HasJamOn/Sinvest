@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root class="@( _isOpen ? "" : "hidden" )">
	<div class="stat-header">
		<label class="money-label">Cash: $@GetPlayerMoney()</label>
	</div>
	<div class="hud">
		@if ( _currentView == ViewState.Main )
		{
			<div class="menu">
				@* Change ViewState.Main to ViewState.Casino here *@
				<button class="menu-button" @onclick="@( () => SetView( ViewState.Casino ) )">Sin.o</button>
				<button class="menu-button" @onclick="@( () => SetView( ViewState.Invest ) )">Invest.o</button>
				<button class="menu-button" @onclick="@( () => OnQuitClick() )">QUIT</button>
			</div>
		}
		else if ( _currentView == ViewState.Casino )
		{
			/* Use the method name directly without the lambda syntax */
			<CasinoMenu OnNavigate="@( new CasinoMenu.NavigateDelegate( HandleNavigation ) )"/>
			<button class="back-button" @onclick="@( () => SetView( ViewState.Main ) )">Back</button>
		}
		else if ( _currentView == ViewState.Invest )
		{
			<InvestMenu/>
			<button class="back-button" @onclick="@( () => SetView( ViewState.Main ) )">Back</button>
		}
		else if ( _currentView == ViewState.CoinFlip )
		{
			<CoinFlip/>
			<button class="back-button" @onclick="@( () => SetView( ViewState.Casino ) )">Back to Casino</button>
		}
	</div>
</root>

@code
{
    private bool _isOpen = false;
    private PlayerController _cachedController;

    private enum ViewState { Main, Casino, Invest, CoinFlip }
    private ViewState _currentView = ViewState.Main;

    /// <summary>
    /// Handles the logic when a game is selected from the CasinoMenu
    /// </summary>
    private void HandleNavigation(string gameName)
    {
	    if (gameName == "Coin Flip")
	    {
		    SetView(ViewState.CoinFlip);
	    }
    }

    private void SetView(ViewState view)
    {
        _currentView = view;
        StateHasChanged(); // Essential for manual delegate updates
    }

    // ===== PUBLIC API =====
    public void Open() => SetMenuState(true);
    public void Close() => SetMenuState(false);
    
    private void OnQuitClick()
    {
        SetMenuState(false); 
        _currentView = ViewState.Main; 
    }

    private void SetMenuState(bool open)
    {
        _isOpen = open;
        Panel.SetClass("hidden", !open);
        Mouse.Visibility = open ? MouseVisibility.Visible : MouseVisibility.Auto;
        Panel.AcceptsFocus = open;
        
        if (open) Panel.Focus();

        if (open && _cachedController == null)
            _cachedController = Scene.GetAllComponents<PlayerController>().FirstOrDefault(x => !x.IsProxy);

        if (_cachedController != null)
        {
            _cachedController.UseLookControls = !open;
            _cachedController.UseInputControls = !open;
            if (open) _cachedController.WishVelocity = Vector3.Zero;
        }
    }
    
    /// <summary>
    /// Fetches the current money stat for the local player
    /// </summary>
    private double _localMoneyCache = -1;

    private double GetPlayerMoney()
    {
	    var stat = Sandbox.Services.Stats.LocalPlayer.Get("money");
    
	    // If this is the first run, or the cloud value changed, update our cache
	    if (_localMoneyCache == -1 || stat.Value != _localMoneyCache)
	    {
		    _localMoneyCache = stat.Value;
	    }

	    return _localMoneyCache;
    }
    
    public static Sinvest Instance { get; private set; }
    protected override void OnAwake() => Instance = this;

    public void RefreshStats() => StateHasChanged();

    // Call this whenever the player performs an action that changes money
    public void AddMoney(double amount)
    {
	    Sandbox.Services.Stats.Increment("money", amount);
	    StateHasChanged(); // Force the UI to refresh the numbers
    }
}
