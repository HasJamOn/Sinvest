@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root class="@( _isOpen ? "" : "hidden" )">
    <div class="stat-header">
       @* The display money is rounded to N0 so you don't see ugly decimals during the animation *@
       <label class="money-label">Cash: $@_displayMoney.ToString("N0")</label>
    </div>
    <div class="hud">
       @if ( _currentView == ViewState.Main )
       {
          <div class="menu">
             <button class="menu-button" @onclick="@( () => SetView( ViewState.Casino ) )">Sin.o</button>
             <button class="menu-button" @onclick="@( () => SetView( ViewState.Invest ) )">Invest.o</button>
             <button class="menu-button" @onclick="@( () => OnQuitClick() )">QUIT</button>
          </div>
       }
       else if ( _currentView == ViewState.Casino )
       {
          <CasinoMenu OnNavigate="@( new CasinoMenu.NavigateDelegate( HandleNavigation ) )"/>
          <button class="back-button" @onclick="@( () => SetView( ViewState.Main ) )">Back</button>
       }
       else if ( _currentView == ViewState.Invest )
       {
          <InvestMenu/>
          <button class="back-button" @onclick="@( () => SetView( ViewState.Main ) )">Back</button>
       }
       else if ( _currentView == ViewState.CoinFlip )
       {
          <CoinFlip/>
          <button class="back-button" @onclick="@( () => SetView( ViewState.Casino ) )">Back to Casino</button>
       }
    </div>
</root>

@code
{
    private bool _isOpen = false;
    private PlayerController _cachedController;

    private enum ViewState { Main, Casino, Invest, CoinFlip }
    private ViewState _currentView = ViewState.Main;

    // --- ANIMATION VARIABLES ---
    private double _displayMoney = 0;   // The visual number that "rolls"
    private double _targetMoney = 0;    // The actual real value we are aiming for
    private bool _initialized = false;

    public static Sinvest Instance { get; private set; }
    protected override void OnAwake() => Instance = this;

    protected override void OnUpdate()
    {
        // 1. Initial setup: Grab the starting value from the cloud
        if (!_initialized)
        {
            var stat = Sandbox.Services.Stats.LocalPlayer.Get("money");
            _targetMoney = stat.Value;
            _displayMoney = _targetMoney; 
            _initialized = true;
            StateHasChanged();
        }

        // 2. Animation logic: If display isn't at target, move it closer
        if ( Math.Abs(_displayMoney - _targetMoney) > 0.1 )
        {
            // Lerp creates the "slow down as it gets closer" effect
            // 8.0f is the speed; increase it for faster counting
            _displayMoney = MathX.Lerp( _displayMoney, _targetMoney, RealTime.Delta * 8.0f );
            
            StateHasChanged();
        }
        else if (_displayMoney != _targetMoney)
        {
            // Snap to target if we are close enough to stop the math
            _displayMoney = _targetMoney;
            StateHasChanged();
        }
    }

    /// <summary>
    /// The primary way to change money. 
    /// Updates the Target immediately, causing the UI to start animating.
    /// </summary>
    public void Transaction(double amount)
    {
        // Update the target value (UI will notice this in OnUpdate)
        _targetMoney += amount;

        // Push to s&box cloud services for permanent saving
        Sandbox.Services.Stats.Increment("money", amount);
    }

    // Handlers for navigation
    private void HandleNavigation(string gameName)
    {
        if (gameName == "Coin Flip") SetView(ViewState.CoinFlip);
    }

    private void SetView(ViewState view)
    {
        _currentView = view;
        StateHasChanged();
    }

    // Public UI controls
    public void Open() => SetMenuState(true);
    public void Close() => SetMenuState(false);
    
    private void OnQuitClick()
    {
        SetMenuState(false); 
        _currentView = ViewState.Main; 
    }

    private void SetMenuState(bool open)
    {
        _isOpen = open;
        Panel.SetClass("hidden", !open);
        Mouse.Visibility = open ? MouseVisibility.Visible : MouseVisibility.Auto;
        Panel.AcceptsFocus = open;
        
        if (open) Panel.Focus();

        if (open && _cachedController == null)
            _cachedController = Scene.GetAllComponents<PlayerController>().FirstOrDefault(x => !x.IsProxy);

        if (_cachedController != null)
        {
            _cachedController.UseLookControls = !open;
            _cachedController.UseInputControls = !open;
            if (open) _cachedController.WishVelocity = Vector3.Zero;
        }
    }

    // Keep this helper for any other components that need the raw number
    private double GetPlayerMoney() => _targetMoney;
}
