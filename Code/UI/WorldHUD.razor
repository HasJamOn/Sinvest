@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Movement;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root class="@(IsVisible ? "visible" : "")">
    @if ( ActiveObject.IsValid() )
    {
        <div class="panel">
            <div class="header">
                <i class="icon">@CurrentIcon</i>
                <div class="name">@CurrentTitle</div>
            </div>

            <div class="divider"></div>

            <div class="actions">
                <div class="action">
                    <label class="key">@CurrentKey</label>
                    <span class="text">@CurrentAction</span>
                </div>
            </div>
        </div>
    }
</root>

@code
{
    private BaseChair _foundChair;
    private UIPopupTrigger _foundTrigger;
    private TimeSince _timeSinceLastHit;

    GameObject ActiveObject => _foundChair?.GameObject ?? _foundTrigger?.GameObject;
    
    // Logic update: Tooltips only show if NO computer popup is currently active
    bool IsVisible => ActiveObject.IsValid() 
                      && _timeSinceLastHit < 0.1f 
                      && !(Player?.WantsHideHud ?? false)
                      && !UIPopupTrigger.ActiveInstance.IsValid();

    string CurrentTitle => _foundChair?.TooltipTitle ?? _foundTrigger?.TooltipTitle ?? string.Empty;
    string CurrentIcon => _foundChair?.TooltipIcon ?? _foundTrigger?.TooltipIcon ?? string.Empty;
    string CurrentAction => _foundChair?.TooltipDescription ?? _foundTrigger?.TooltipDescription ?? string.Empty;
    string CurrentKey => _foundChair != null ? Input.GetButtonOrigin( "use" ).ToUpper() : _foundTrigger?.ToolTipKey?.ToUpper();

    protected override void OnUpdate()
    {
        var controller = Scene.GetAllComponents<PlayerController>().FirstOrDefault( x => !x.IsProxy );
        if ( controller == null ) return;

        var ray = Scene.Camera.ScreenNormalToRay( 0.5f );
        var tr = Scene.Trace.Ray( ray, 150f )
                    .WithoutTags( "player" ) 
                    .Run();

        if ( tr.Hit && tr.GameObject.IsValid() )
        {
            bool isSitting = controller.Mode is SitMoveMode;
            
            var chair = !isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<BaseChair>() : null;
            var trigger = isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<UIPopupTrigger>() : null;

            if ( chair.IsValid() || trigger.IsValid() )
            {
                _foundChair = chair;
                _foundTrigger = trigger;
                _timeSinceLastHit = 0;
            }
        }

        if ( _timeSinceLastHit > 0.15f )
        {
            _foundChair = null;
            _foundTrigger = null;
        }

        SetClass( "visible", IsVisible );
    }

    Player Player => Player.FindLocalPlayer();

    protected override int BuildHash() 
    {
        // Adding ActiveInstance to the hash ensures the UI re-renders 
        // the moment a computer is opened or closed.
        return System.HashCode.Combine( 
            ActiveObject?.Id, 
            IsVisible,
            CurrentTitle,
            UIPopupTrigger.ActiveInstance.IsValid()
        );
    }
}
