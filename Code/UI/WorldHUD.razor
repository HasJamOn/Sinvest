@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

@if ( Player.IsValid() && Player.WantsHideHud )
    return;

@if ( !HasAnyAction )
    return;

<root>
    <div class="panel">
       <div class="header">
          <i class="icon">@CurrentIcon</i>
          <div class="name">@CurrentTitle</div>
       </div>

       <div class="divider"></div>

       <div class="actions">
          <div class="action">
             @* Logic: If chair, get the bound key for "use". If trigger, show the raw string. *@
             <label class="key">@( _foundChair != null ? Input.GetButtonOrigin( "use" ).ToUpper() : _foundTrigger?.ToolTipKey.ToUpper() )</label>
             <span class="text">@CurrentAction</span>
          </div>
       </div>
    </div>
</root>

@code
{
    private BaseChair _foundChair;
    private UIPopupTrigger _foundTrigger;
    private TimeSince _timeSinceLastHit;

    // Visuals
    string CurrentTitle => _foundChair?.TooltipTitle ?? _foundTrigger?.TooltipTitle;
    string CurrentIcon => _foundChair?.TooltipIcon ?? _foundTrigger?.TooltipIcon;
    string CurrentAction => _foundChair?.TooltipDescription ?? _foundTrigger?.TooltipDescription;

    bool HasAnyAction => (_foundChair.IsValid() || _foundTrigger.IsValid()) && _timeSinceLastHit < 0.1f;

    protected override void OnUpdate()
    {
        var ray = Scene.Camera.ScreenNormalToRay( 0.5f );
        var tr = Scene.Trace.Ray( ray, 150f ).WithoutTags( "player", "trigger" ).Run();
        
        if ( tr.Hit && tr.GameObject.IsValid() )
        {
            var chair = tr.GameObject.Components.GetInAncestorsOrSelf<BaseChair>();
            var trigger = tr.GameObject.Components.GetInAncestorsOrSelf<UIPopupTrigger>();

            if ( chair.IsValid() || trigger.IsValid() )
            {
                _foundChair = chair;
                _foundTrigger = trigger;
                _timeSinceLastHit = 0;
            }
        }

        SetClass( "visible", HasAnyAction );
    }

    Player Player => Player.FindLocalPlayer();

    // Include the ToolTipKey in the hash so if you change it in the inspector, the UI refreshes
    protected override int BuildHash() => System.HashCode.Combine( CurrentTitle, CurrentAction, _foundTrigger?.ToolTipKey, Player?.WantsHideHud );
}
