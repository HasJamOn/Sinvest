@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Movement;
@inherits PanelComponent
@namespace Sandbox

@if ( Player.IsValid() && Player.WantsHideHud )
    return;

@if ( !HasAnyAction )
    return;

<root>
    <div class="panel">
        <div class="header">
            <i class="icon">@CurrentIcon</i>
            <div class="name">@CurrentTitle</div>
        </div>

        <div class="divider"></div>

        <div class="actions">
            <div class="action">
                @* Use 'use' bind for chairs, and the custom ToolTipKey for the computer *@
                <label class="key">@( _foundChair != null ? Input.GetButtonOrigin( "use" ).ToUpper() : _foundTrigger?.ToolTipKey.ToUpper() )</label>
                <span class="text">@CurrentAction</span>
            </div>
        </div>
    </div>
</root>

@code
{
    private BaseChair _foundChair;
    private UIPopupTrigger _foundTrigger;
    private TimeSince _timeSinceLastHit;

    string CurrentTitle => _foundChair?.TooltipTitle ?? _foundTrigger?.TooltipTitle;
    string CurrentIcon => _foundChair?.TooltipIcon ?? _foundTrigger?.TooltipIcon;
    string CurrentAction => _foundChair?.TooltipDescription ?? _foundTrigger?.TooltipDescription;

    bool HasAnyAction => (_foundChair != null || _foundTrigger != null) && _timeSinceLastHit < 0.1f;

    protected override void OnUpdate()
    {
        // 1. Find the local controller (using the same logic that worked in the debugger)
        var controller = Scene.GetAllComponents<PlayerController>().FirstOrDefault( x => !x.IsProxy );
        if ( controller == null ) return;

        // 2. Identify state based on the debugger's success
        bool isSitting = controller.Mode is SitMoveMode;

        var ray = Scene.Camera.ScreenNormalToRay( 0.5f );
        
        // Trace logic: We remove "trigger" filter so we can actually hit the Computer's UIPopupTrigger
        var tr = Scene.Trace.Ray( ray, 150f )
                    .WithoutTags( "player" ) 
                    .Run();
        
        _foundChair = null;
        _foundTrigger = null;

        if ( tr.Hit && tr.GameObject != null )
        {
            if ( isSitting )
            {
                // While sitting, only look for the computer trigger
                _foundTrigger = tr.GameObject.Components.GetInAncestorsOrSelf<UIPopupTrigger>();
            }
            else
            {
                // While standing, only look for chairs
                _foundChair = tr.GameObject.Components.GetInAncestorsOrSelf<BaseChair>();
            }

            if ( _foundChair != null || _foundTrigger != null )
            {
                _timeSinceLastHit = 0;
            }
        }

        SetClass( "visible", HasAnyAction );
    }

    Player Player => Player.FindLocalPlayer();

    protected override int BuildHash() 
    {
        var controller = Scene.GetAllComponents<PlayerController>().FirstOrDefault( x => !x.IsProxy );
        return System.HashCode.Combine( 
            CurrentTitle, 
            CurrentAction, 
            _foundTrigger?.ToolTipKey, 
            Player?.WantsHideHud,
            (controller?.Mode is SitMoveMode) // Force UI refresh when sitting state changes
        );
    }
}
