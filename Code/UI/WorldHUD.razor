@using Sandbox; 
@using Sinvest;
@using Sandbox.UI;
@using Sandbox.Movement;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root class="@(IsVisible ? "visible" : "")">
    @if ( ActiveObject.IsValid() && !string.IsNullOrEmpty(CurrentTitle) )
    {
       <div class="panel">
          <div class="header">
             @if ( !string.IsNullOrEmpty(CurrentIcon) )
             {
                <i class="icon">@CurrentIcon</i>
             }
             <div class="name">@CurrentTitle</div>
          </div>

          <div class="divider"></div>

          <div class="actions">
             <div class="action">
                <label class="key">@CurrentKey</label>
                <span class="text">@CurrentAction</span>
             </div>
          </div>
       </div>
    }
</root>

@code
{
    private BaseChair _foundChair;
    private UIPopupTrigger _foundTrigger;
    private SteamGameCase _foundCase;
    private TimeSince _timeSinceLastHit;

    GameObject ActiveObject => _foundChair?.GameObject ?? _foundTrigger?.GameObject ?? _foundCase?.GameObject;
    
    // UPDATED: Added check for SinvestOS.Instance to hide tooltips when OS is up (Phone or PC)
    bool IsVisible => ActiveObject.IsValid() 
                      && _timeSinceLastHit < 0.1f 
                      && !(Player?.WantsHideHud ?? false)
                      && !UIPopupTrigger.ActiveInstance.IsValid()
                      && SinvestOS.Instance == null; // New Check

    string CurrentTitle => _foundChair?.TooltipTitle ?? _foundTrigger?.TooltipTitle ?? _foundCase?.TooltipTitle ?? string.Empty;
    string CurrentIcon => _foundChair?.TooltipIcon ?? _foundTrigger?.TooltipIcon ?? _foundCase?.TooltipIcon ?? string.Empty;
    string CurrentAction => _foundChair?.TooltipDescription ?? _foundTrigger?.TooltipDescription ?? _foundCase?.TooltipDescription ?? string.Empty;
    
    string CurrentKey => (_foundChair != null || _foundCase != null) 
                         ? Input.GetButtonOrigin( "use" ).ToUpper() 
                         : _foundTrigger?.ToolTipKey?.ToUpper();

    protected override void OnUpdate()
    {
        // Optimization: Early exit if SinvestOS is active to stop tracing entirely
        if ( SinvestOS.Instance != null )
        {
            _foundChair = null;
            _foundTrigger = null;
            _foundCase = null;
            return;
        }

        var controller = Scene.GetAllComponents<PlayerController>().FirstOrDefault( x => !x.IsProxy );
        if ( controller == null ) return;

        var ray = Scene.Camera.ScreenNormalToRay( 0.5f );
        var tr = Scene.Trace.Ray( ray, 150f )
                    .WithoutTags( "player" ) 
                    .Run();

        if ( tr.Hit && tr.GameObject.IsValid() )
        {
            bool isSitting = controller.Mode is SitMoveMode;
    
            var chair = !isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<BaseChair>() : null;
            var trigger = isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<UIPopupTrigger>() : null;
            var sCase = !isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<SteamGameCase>() : null;

            if ( chair.IsValid() || trigger.IsValid() || sCase.IsValid() )
            {
               _foundChair = chair;
               _foundTrigger = trigger;
               _foundCase = sCase; 
               _timeSinceLastHit = 0;
            }
        }
        
        if ( _foundCase.IsValid() && IsVisible && Input.Pressed( "use" ) )
        {
            _foundCase.Shuffle();
        }

        if ( _timeSinceLastHit > 0.15f )
        {
            _foundChair = null;
            _foundTrigger = null;
            _foundCase = null; 
        }

        SetClass( "visible", IsVisible );
    }

    Player Player => Player.FindLocalPlayer();

    protected override int BuildHash() 
    {
        return System.HashCode.Combine( 
           ActiveObject?.Id, 
           IsVisible,
           _foundCase?.TooltipTitle,
           _foundCase?.TooltipDescription,
           UIPopupTrigger.ActiveInstance.IsValid(),
           SinvestOS.Instance != null // Added to BuildHash to ensure UI refreshes when OS opens/closes
        );
    }
}
