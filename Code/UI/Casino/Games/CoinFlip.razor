@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel
@namespace Sandbox

<root>
    <div class="coinflip-card">
       <label class="title">COIN FLIP</label>

       <div class="button-row">
          <button class="side-btn @(SelectedSide == Side.Heads ? "active" : "")" @onclick="@(() => SetSide(Side.Heads))">CHOOSE HEADS</button>
          <button class="side-btn @(SelectedSide == Side.Tails ? "active" : "")" @onclick="@(() => SetSide(Side.Tails))">CHOOSE TAILS</button>
       </div>

       <div class="coin-wrapper">
           <img class="coin-img @SquishClass @FlipAnimClass" 
                src="@CoinImageSrc" 
                style="transition: transform @(SpinSpeed)s ease-in-out;" />
       </div>

       <div class="selection-indicator">
          <label>Current Selection: </label>
          <label class="highlight">@SelectedSide.ToString()</label>
       </div>

       <div class="input-group">
          <label>Amount:</label>
          <TextEntry Value:bind="@BetAmount" Numeric="@true" />
       </div>

       <button class="play-btn @(IsFlipping || !CanAfford ? "disabled" : "")" @onclick="@PlayGame">
           @(IsFlipping ? "FLIPPING..." : "FLIP COIN")
       </button>

       @if (!string.IsNullOrEmpty(ResultMessage))
       {
          <div class="result-display">
             <label class="flip-result">The coin landed on: @LastFlip</label>
             <label class="outcome @(IsWin ? "win" : "loss")">@ResultMessage</label>
          </div>
       }
    </div>
</root>

@code
{
    public enum Side { Heads, Tails }

    private Side SelectedSide = Side.Heads;
    private string BetAmount = "10";
    private string LastFlip = "Heads";
    private string ResultMessage = "";
    private bool IsWin = false;
    private bool IsFlipping = false;
    
    private string FlipAnimClass = "";
    private bool IsSquished = false;
    private string SquishClass => IsSquished ? "squished" : "";
    private float SpinSpeed = 0.05f; 
    
    private Side DisplaySide = Side.Heads; 
    private string CoinImageSrc => $"/ui/casino/coinflip/coin_{DisplaySide.ToString().ToLower()}.png";

    // New Helper for the UI
    private bool CanAfford => float.TryParse(BetAmount, out float amount) && 
                              ComputerHUD.Instance != null && 
                              ComputerHUD.Instance.CurrentMoney >= amount;

    private void SetSide(Side side)
    {
       if (IsFlipping) return;
       SelectedSide = side;
       StateHasChanged();
    }

    private async void PlayGame()
    {
        if (IsFlipping) return;

        // 1. Validation
        if (!float.TryParse(BetAmount, out float amount) || amount <= 0) return;
        
        // Final check against the HUD's current balance
        if (ComputerHUD.Instance == null || ComputerHUD.Instance.CurrentMoney < amount)
        {
            ResultMessage = "INSUFFICIENT FUNDS!";
            return;
        }

        // 2. Immediate Deduction
        ComputerHUD.Instance.Transaction(-amount);

        // Pre-calculate result
        var result = Game.Random.Int(0, 1) == 0 ? Side.Heads : Side.Tails;
        
        IsFlipping = true;
        ResultMessage = "";
        FlipAnimClass = "";
        StateHasChanged();

        // 3. Animation Loop
        int totalFlips = 12; 
        float currentSpeed = 0.05f;

        for (int i = 0; i < totalFlips; i++)
        {
            SpinSpeed = currentSpeed;
            IsSquished = true;
            StateHasChanged();
            await GameTask.DelaySeconds(currentSpeed);

            DisplaySide = (DisplaySide == Side.Heads) ? Side.Tails : Side.Heads;

            IsSquished = false;
            StateHasChanged();
            await GameTask.DelaySeconds(currentSpeed);

            if (i > 4) currentSpeed += 0.02f; 
        }

        // 4. Settle
        SpinSpeed = currentSpeed + 0.05f;
        IsSquished = true;
        StateHasChanged();
        await GameTask.DelaySeconds(SpinSpeed);

        DisplaySide = result;
        IsSquished = false;
        FlipAnimClass = "settling";
        StateHasChanged();

        await GameTask.DelaySeconds(0.6f);

        // 5. Resolution
        LastFlip = result.ToString();
        IsWin = (SelectedSide == result);
        IsFlipping = false;

        if (IsWin)
        {
            // Refund initial bet + pay out winnings (2x total)
            ComputerHUD.Instance.Transaction(amount * 2);
            ResultMessage = $"YOU WON ${amount}!";
        }
        else
        {
            ResultMessage = $"YOU LOST ${amount}!";
        }

        StateHasChanged();
    }

    protected override int BuildHash()
    {
        return HashCode.Combine(
           SelectedSide, 
           BetAmount, 
           IsFlipping, 
           DisplaySide, 
           IsSquished, 
           ComputerHUD.Instance?.CurrentMoney, // Re-renders if balance changes
           ResultMessage
        );
    }
}
