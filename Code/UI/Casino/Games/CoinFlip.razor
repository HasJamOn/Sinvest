@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel
@namespace Sandbox

<root>
    <div class="coinflip-card">
       <label class="title">COIN FLIP</label>

       <div class="button-row">
          <button class="side-btn @(SelectedSide == Side.Heads ? "active" : "")" @onclick="@(() => SetSide(Side.Heads))">CHOOSE HEADS</button>
          <button class="side-btn @(SelectedSide == Side.Tails ? "active" : "")" @onclick="@(() => SetSide(Side.Tails))">CHOOSE TAILS</button>
       </div>

       <div class="coin-wrapper">
          <img class="coin-img @SquishClass @FlipAnimClass" 
               style="transition: transform @(SpinSpeed)s ease-in-out;" 
               src="@CoinImageSrc" />
       </div>

       <div class="selection-indicator">
          <label>Current Selection: </label>
          <label class="highlight">@SelectedSide.ToString()</label>
       </div>

       <div class="input-group">
          <label>Amount:</label>
          <TextEntry Value:bind="@BetAmount" Numeric="@true" />
       </div>

       <button class="play-btn @(IsFlipping ? "flipping" : "")" @onclick="@PlayGame">FLIP COIN</button>

       @if (!string.IsNullOrEmpty(ResultMessage))
       {
          <div class="result-display">
             <label class="flip-result">The coin landed on: @LastFlip</label>
             <label class="outcome @(IsWin ? "win" : "loss")">@ResultMessage</label>
          </div>
       }
    </div>
</root>

@code
{
    public enum Side { Heads, Tails }

    private Side SelectedSide = Side.Heads;
    private string BetAmount = "10";
    private string LastFlip = "Heads";
    private string ResultMessage = "";
    private bool IsWin = false;
    private bool IsFlipping = false;
    
    // Animation States
    private string FlipAnimClass = "";
    private bool IsSquished = false;
    private string SquishClass => IsSquished ? "squished" : "";
    private float SpinSpeed = 0.05f; 
    
    private Side DisplaySide = Side.Heads; 
    private string CoinImageSrc => $"/ui/casino/coinflip/coin_{DisplaySide.ToString().ToLower()}.png";

    private void SetSide(Side side)
    {
       if (IsFlipping) return;
       SelectedSide = side;
       StateHasChanged();
    }

    private async void PlayGame()
    {
        if (IsFlipping) return;

        // 1. Setup & calculate outcome immediately
        if (!float.TryParse(BetAmount, out float amount)) amount = 0;
        var roll = Game.Random.Int(1, 2);
        var result = (roll == 1) ? Side.Heads : Side.Tails;
        
        IsFlipping = true;
        ResultMessage = "";
        FlipAnimClass = "";
        StateHasChanged();

        // 2. The Controlled Spin Loop
        int totalFlips = 12; // Number of half-rotations
        float currentSpeed = 0.05f; // Fast initial spin

        for (int i = 0; i < totalFlips; i++)
        {
            // SQUISH (Hide)
            SpinSpeed = currentSpeed;
            IsSquished = true;
            StateHasChanged();
            await GameTask.DelaySeconds(currentSpeed); // Wait for transition to hit 0 width

            // SWAP IMAGE (While invisible)
            DisplaySide = (DisplaySide == Side.Heads) ? Side.Tails : Side.Heads;

            // EXPAND (Reveal)
            IsSquished = false;
            StateHasChanged();
            await GameTask.DelaySeconds(currentSpeed); // Wait for transition to hit full width

            // Gradually slow down the flipping speed after a few spins
            if (i > 4) 
            {
                currentSpeed += 0.02f; 
            }
        }

        // 3. Final Targeted Settle
        // One last squish to guarantee we land on the pre-calculated result face
        SpinSpeed = currentSpeed + 0.05f; // Slow dramatic final turn
        IsSquished = true;
        StateHasChanged();
        await GameTask.DelaySeconds(SpinSpeed);

        DisplaySide = result; // Force the target face
        IsSquished = false;
        FlipAnimClass = "settling"; // Trigger the CSS scale bounce
        StateHasChanged();

        await GameTask.DelaySeconds(0.6f); // Wait for the settle bounce

        // 4. Logic Resolution
        LastFlip = result.ToString();
        IsWin = (SelectedSide == result);
        IsFlipping = false;

        if (IsWin)
        {
            Sinvest.Instance?.Transaction(amount);
            ResultMessage = $"YOU WON ${amount}!";
        }
        else
        {
            Sinvest.Instance?.Transaction(-amount);
            ResultMessage = $"YOU LOST ${amount}!";
        }

        StateHasChanged();
    }

    protected override int BuildHash()
    {
	    var hash = new HashCode();
	    hash.Add(SelectedSide);
	    hash.Add(BetAmount);
	    hash.Add(LastFlip);
	    hash.Add(ResultMessage);
	    hash.Add(IsFlipping);
	    hash.Add(FlipAnimClass);
	    hash.Add(DisplaySide);
	    hash.Add(IsSquished);
	    hash.Add(SpinSpeed);
	    return hash.ToHashCode();
    }
    
}
