@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	<div class="casino-grid">
		<button class="game-card" @onclick="@(() => OnGameClick("Coin Flip"))">
			<label class="title">Coin Flip</label>
		</button>

		@for (int i = 0; i < 5; i++)
		{
			<button class="game-card unnamed" @onclick="@(() => OnGameClick("Unnamed"))">
				<label class="title">Unnamed</label>
			</button>
		}
	</div>
</root>

@code
{
	// Define a delegate at the top of your code block
	public delegate void NavigateDelegate(string gameName);

	// Use the delegate as the property
	[Property] public NavigateDelegate OnNavigate { get; set; }

	private void OnGameClick(string gameName)
	{
		Log.Info($"Attempting to launch: {gameName}");
       
		// Use the standard C# null-conditional invocation
		OnNavigate?.Invoke(gameName);
	}
}
