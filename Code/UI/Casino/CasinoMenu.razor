@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	<div class="casino-grid">
		@* Explicitly calling Coin Flip *@
		<button class="game-card" @onclick="@(() => Navigate<CoinFlip>())">
			<label class="title">Coin Flip</label>
		</button>

		@* Placeholders for future games/jobs *@
		@for (int i = 0; i < 5; i++)
		{
			<button class="game-card unnamed">
				<label class="title">Coming Soon</label>
			</button>
		}
	</div>
</root>

@code
{
	private void Navigate<T>() where T : Panel, new()
	{
		// Talk directly to the HUD instance we created earlier
		GameHUD.Instance?.SetView<T>();
	}
}
