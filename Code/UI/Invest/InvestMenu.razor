@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Services;
@using System;
@inherits Panel
@namespace Sandbox

<root>
    <div class="header">
       <label>FUND.INO INDEX</label>
       <div class="status @(MarketService.IsReady ? "online" : "offline")"></div>
    </div>

    @if ( !MarketService.IsReady )
    {
       <div class="loading">SYNCING WITH B4BLOCK.ORG...</div>
    }
    else
    {
       <div class="price-hero">
          <h1>$@MarketService.CurrentPrice.ToString("N2")</h1>
          <label>GLOBAL ASSET PRICE (UTC)</label>
       </div>

       <div class="stats-row">
          <div class="stat">
             <label>SHARES</label>
             <span>@(ComputerHUD.Instance?.CurrentShares.ToString("N0") ?? "0")</span>
          </div>
          <div class="stat">
             <label>EQUITY</label>
             <span>$@(((ComputerHUD.Instance?.CurrentShares ?? 0) * MarketService.CurrentPrice).ToString("N2"))</span>
          </div>
       </div>

       <div class="actions">
           <button class="buy @(!CanAfford || IsProcessing ? "disabled" : "")" 
                   @onclick="@( () => DoTrade(1) )">
              BUY 1 SBOX
           </button>

           <button class="sell @(!CanSell || IsProcessing ? "disabled" : "")" 
                   @onclick="@( () => DoTrade(-1) )">
              SELL 1 SBOX
           </button>
       </div>
    }
</root>

@code {
    private TimeSince _lastSync = 0;
    private bool IsProcessing = false;

    // Logic tied directly to the HUD Instance
    private bool CanAfford => ComputerHUD.Instance != null && 
                              ComputerHUD.Instance.CurrentMoney >= MarketService.CurrentPrice;

    private bool CanSell => ComputerHUD.Instance != null && 
                            ComputerHUD.Instance.CurrentShares >= 1;

    protected override void OnAfterTreeRender( bool firstTime )
    {
       if ( !firstTime ) return;
       
       // MarketService.Sync handles the global price, HUD handles the local player stats
       _ = MarketService.Sync();
    }

    public override void Tick()
    {
       // Keep the market price fresh
       if ( _lastSync > 15f ) 
       {
          _ = MarketService.Sync();
          _lastSync = 0;
       }
    }

    private async void DoTrade(int amount)
    {
        if (IsProcessing) return;

        IsProcessing = true;
        StateHasChanged();

        // 1. Await without a try-catch to satisfy the sbox whitelist
        await MarketService.Sync();
    
        double totalCost = MarketService.CurrentPrice * amount;

        // 2. Final logic check before committing
        if (amount < 0 && (ComputerHUD.Instance?.CurrentShares ?? 0) < Math.Abs(amount)) 
        {
           IsProcessing = false;
           StateHasChanged();
           return;
        }

        // 3. Update the HUD (which handles the UI animation and the EconomyManager cloud save)
        ComputerHUD.Instance?.Transaction(-totalCost, (double)amount);
    
        // 4. Artificial delay to prevent button spamming
        await GameTask.Delay(100); 
        IsProcessing = false;
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        // Adding CurrentShares and CurrentMoney here is CRITICAL.
        // It tells the UI to re-render when those values change in the HUD.
        return HashCode.Combine(
           MarketService.CurrentPrice, 
           MarketService.IsReady, 
           IsProcessing,
           ComputerHUD.Instance?.CurrentMoney,
           ComputerHUD.Instance?.CurrentShares
        );
    }
}
