@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using System.Collections.Generic;

@inherits Panel
@namespace Sandbox

<root>
    <div class="header">
       <label>FUND.INO INDEX</label>
       <div class="status @(MarketService.IsReady ? "online" : "offline")"></div>
    </div>

    @if ( !MarketService.IsReady )
    {
       <div class="loading">SYNCING WITH B4BLOCK.ORG...</div>
    }
    else
    {
       <div class="price-hero">
          <div class="price-display">
              <h1>$@MarketService.CurrentPrice.ToString("N2")</h1>
              <label>GLOBAL ASSET PRICE (UTC)</label>
          </div>

          <div class="range-picker">
	          @foreach ( var range in TimeRanges.Keys )
	          {
		          <button class="@(CurrentRange == range ? "active" : "")" 
		                  @onclick="@(() => SetRange(range))">
			          @range
		          </button>
	          }
          </div>

          <div class="graph-window">
	          <MarketGraph @ref="GraphCanvas" class="graph-painter" />
          </div>
       </div>

       <div class="stats-row">
          <div class="stat">
             <label>SHARES</label>
             <span>@(ComputerHUD.Instance?.CurrentShares.ToString("N0") ?? "0")</span>
          </div>
          <div class="stat">
             <label>EQUITY</label>
             <span>$@(((ComputerHUD.Instance?.CurrentShares ?? 0) * MarketService.CurrentPrice).ToString("N2"))</span>
          </div>
       </div>

       <div class="actions">
           <button class="buy @(!CanAfford || IsProcessing ? "disabled" : "")" 
                   @onclick="@( () => DoTrade(1) )">
              BUY 1 SBOX
           </button>

           <button class="sell @(!CanSell || IsProcessing ? "disabled" : "")" 
                   @onclick="@( () => DoTrade(-1) )">
              SELL 1 SBOX
           </button>
       </div>
    }
</root>

@code {
    private MarketGraph GraphCanvas;
    private bool IsProcessing = false;
    private double LastPrice;
    private string CurrentRange = "1D";
    private bool Initialized = false; // Track if we've successfully drawn the first time

    private readonly Dictionary<string, int> TimeRanges = new()
    {
        { "1D", 60 * 24 },
        { "5D", 60 * 24 * 5 },
        { "1M", 60 * 24 * 30 },
        { "6M", 60 * 24 * 180 },
        { "YTD", 0 },
        { "1Y", 60 * 24 * 365 },
        { "5Y", 60 * 24 * 365 * 5 },
        { "MAX", 60 * 24 * 365 * 10 }
    };

    private bool CanAfford => ComputerHUD.Instance != null && 
                              ComputerHUD.Instance.CurrentMoney >= MarketService.CurrentPrice;

    private bool CanSell => ComputerHUD.Instance != null && 
                            ComputerHUD.Instance.CurrentShares >= 1;

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( firstTime )
        {
           if ( MarketService.PriceHistory.Count < 2 )
           {
              PreFillHistory();
           }
           
           // We attempt a refresh, but Tick will handle the fallback if Width is 0
           RefreshGraph();
        }
    }
    
    private void PreFillHistory()
    {
        var system = Scene.GetAllComponents<MarketServerSystem>().FirstOrDefault();
        if (system == null) return;

        var now = DateTime.UtcNow;
        for (int i = 59; i >= 0; i--)
        {
           var time = now.AddMinutes(-i);
           int seed = MarketServerSystem.GetSeedAtTime(time, system.CurrentSeed, system.CurrentEraStart);
           double price = MarketServerSystem.CalculatePrice(time, seed, false);
           MarketService.UpdatePrice(price);
        }
    }

    public override void Tick()
    {
        // FAIL-SAFE: If we haven't successfully drawn yet (due to 0-width layout),
        // keep trying until the panel has dimensions.
        if ( !Initialized && GraphCanvas != null && GraphCanvas.Box.Rect.Width > 0 )
        {
            RefreshGraph();
            return; 
        }

        if ( MarketService.CurrentPrice != LastPrice )
        {
           LastPrice = MarketService.CurrentPrice;
           RefreshGraph();
           StateHasChanged();
        }
    }

    private void SetRange(string range)
    {
        if (CurrentRange == range) return;
        CurrentRange = range;
        RefreshGraph();
    }

    private void RefreshGraph()
    {
        if ( GraphCanvas == null ) return;

        // If layout isn't ready, don't mark as Initialized, just exit and wait for Tick
        if ( GraphCanvas.Box.Rect.Width <= 0 ) return;

        // Once we pass this point, we have dimensions!
        Initialized = true;

        if ( CurrentRange == "1D" )
        {
            GraphCanvas.History = MarketService.PriceHistory.ToList();
            GraphCanvas.UpdateGraph();
            return;
        }

        var system = Scene.GetAllComponents<MarketServerSystem>().FirstOrDefault();
        if (system == null) return;

        List<double> data = new();
        var now = DateTime.UtcNow;
        int resolution = 60; 

        int totalMinutes = TimeRanges.ContainsKey( CurrentRange ) ? TimeRanges[CurrentRange] : 1440;
        
        if ( CurrentRange == "YTD" )
        {
            var yearStart = new DateTime( now.Year, 1, 1, 0, 0, 0, DateTimeKind.Utc );
            totalMinutes = (int)(now - yearStart).TotalMinutes;
        }

        int step = Math.Max( 1, totalMinutes / resolution );

        for ( int i = 0; i < resolution; i++ )
        {
            var time = now.AddMinutes( -(i * step) );
            int seed = MarketServerSystem.GetSeedAtTime( time, system.CurrentSeed, system.CurrentEraStart );
            data.Add( MarketServerSystem.CalculatePrice( time, seed, false ) );
        }

        data.Reverse(); 
        GraphCanvas.History = data;
        GraphCanvas.UpdateGraph();
    }

    private async void DoTrade(int amount)
    {
        if (IsProcessing || !MarketService.IsReady) return;
        IsProcessing = true;
        StateHasChanged();
    
        double totalCost = MarketService.CurrentPrice * amount;
        if (amount < 0 && (ComputerHUD.Instance?.CurrentShares ?? 0) < Math.Abs(amount)) 
        {
           IsProcessing = false;
           StateHasChanged();
           return;
        }

        ComputerHUD.Instance?.Transaction(-totalCost, (double)amount);
        await GameTask.Delay(100); 
        IsProcessing = false;
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        return HashCode.Combine(MarketService.CurrentPrice, IsProcessing, ComputerHUD.Instance?.CurrentMoney, CurrentRange);
    }
}
