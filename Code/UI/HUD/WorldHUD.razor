@using Sandbox; 
@using Sinvest;
@using Sandbox.UI;
@using Sandbox.Movement;
@using System;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root class="@(IsVisible ? "visible" : "")">

    @* ── WageWars cube panel ─────────────────────────────────────────── *@
    @if ( _hoveredCube.IsValid() )
    {
        <div class="panel">
            <div class="header @(IsCubeOwner || _hoveredCube.OwnerId == Guid.Empty ? "" : "hostile")">
                <i class="icon">@(IsCubeOwner ? "layers" : "swords")</i>
                <div class="name">@CubeTitle</div>
            </div>

            @if ( CubeWarning is string warning )
            {
                <div class="description warning">@warning</div>
            }
            else
            {
                <div class="description">
                    @(IsCubeOwner ? $"Level {_hoveredCube.Value} Structure" : $"Grid [{_hoveredCube.GridPosition.x}, {_hoveredCube.GridPosition.y}]")
                </div>
            }

            <div class="divider"></div>

            <div class="actions">
                <div class="action @(CanActOnCube ? "" : "disabled")">
                    <label class="key">@Input.GetButtonOrigin( "use" ).ToUpper()</label>
                    <span class="text">@CubeActionText</span>
                </div>
            </div>
        </div>
    }

    @* ── World-object panel (chair / trigger / case / dishwasher) ────── *@
    @if ( !_hoveredCube.IsValid() && WorldObject.IsValid() && !string.IsNullOrEmpty( WorldTitle ) )
    {
        <div class="panel">
            <div class="header">
                @if ( !string.IsNullOrEmpty( WorldIcon ) )
                {
                    <i class="icon">@WorldIcon</i>
                }
                <div class="name">@WorldTitle</div>
            </div>

            <div class="divider"></div>

            <div class="actions">
                <div class="action">
                    <label class="key">@WorldKey</label>
                    <span class="text">@WorldAction</span>
                </div>
            </div>
        </div>
    }

</root>

@code
{
    // ── Shared state ──────────────────────────────────────────────────────

    private TimeSince _timeSinceLastHit;

    bool IsVisible => _timeSinceLastHit < 0.1f
                      && !(Player?.WantsHideHud ?? false)
                      && !UIPopupTrigger.ActiveInstance.IsValid()
                      && !(SinvestOS.Instance?.IsOpen ?? false);

    // ── WageWars cube ─────────────────────────────────────────────────────

    private WageWarsCube _hoveredCube;

    bool IsCubeOwner
    {
        get
        {
            if ( !_hoveredCube.IsValid() ) return false;
            var me = Scene.GetAllComponents<WageWarsPlayer>().FirstOrDefault( p => !p.IsProxy );
            return me != null && _hoveredCube.OwnerId == me.GameObject.Id;
        }
    }

    string CubeTitle   => _hoveredCube.OwnerId == Guid.Empty ? "Unclaimed"
                        : IsCubeOwner                        ? "Your Territory"
                                                             : "Hostile Tile";

    string CubeWarning => _hoveredCube.IsValid()
                        ? (IsCubeOwner ? _hoveredCube.GetUpgradeRequirement() : _hoveredCube.GetAttackRequirement())
                        : null;

    bool   CanActOnCube    => string.IsNullOrEmpty( CubeWarning );

    string CubeActionText
    {
        get
        {
            if ( !_hoveredCube.IsValid() ) return "";
            if ( _hoveredCube.Value == 0 ) return "Claim Territory";
            return IsCubeOwner ? "Upgrade Layer" : "Attack Structure";
        }
    }

    // ── World objects (chair / trigger / case / dishwasher) ───────────────

    private BaseChair              _foundChair;
    private UIPopupTrigger         _foundTrigger;
    private SteamGameCase          _foundCase;
    private DishwasherWorkTrigger  _foundDishwasher;

    GameObject WorldObject => _foundChair?.GameObject ?? _foundTrigger?.GameObject ?? _foundCase?.GameObject ?? _foundDishwasher?.GameObject;
    
    string WorldTitle => _foundChair?.TooltipTitle 
                      ?? _foundTrigger?.TooltipTitle 
                      ?? _foundCase?.TooltipTitle 
                      ?? _foundDishwasher?.TooltipTitle 
                      ?? string.Empty;

    string WorldIcon => _foundChair?.TooltipIcon 
                     ?? _foundTrigger?.TooltipIcon 
                     ?? _foundCase?.TooltipIcon 
                     ?? _foundDishwasher?.TooltipIcon 
                     ?? string.Empty;

    string WorldAction => _foundChair?.TooltipDescription 
                       ?? _foundTrigger?.TooltipDescription 
                       ?? _foundCase?.TooltipDescription 
                       ?? _foundDishwasher?.TooltipDescription 
                       ?? string.Empty;

    string WorldKey => (_foundChair != null || _foundCase != null || _foundDishwasher != null)
                    ? Input.GetButtonOrigin( "use" ).ToUpper()
                    : _foundTrigger?.ToolTipKey?.ToUpper();

    // ── Per-frame ─────────────────────────────────────────────────────────

    protected override void OnUpdate()
    {
        if ( SinvestOS.Instance.IsValid() && SinvestOS.Instance.IsOpen )
        {
            ClearAll();
            return;
        }

        var controller = Scene.GetAllComponents<PlayerController>().FirstOrDefault( x => !x.IsProxy );
        if ( controller == null ) return;

        var ray = Scene.Camera.ScreenNormalToRay( 0.5f );
        var tr  = Scene.Trace.Ray( ray, 150f )
                      .WithoutTags( "player" )
                      .Run();

        if ( tr.Hit && tr.GameObject.IsValid() )
        {
            var cube = tr.GameObject.Components.GetInAncestorsOrSelf<WageWarsCube>();
            if ( cube.IsValid() )
            {
                ClearWorldObjects();
                _hoveredCube = cube;
                _timeSinceLastHit = 0;
            }
            else
            {
                bool isSitting = controller.Mode is SitMoveMode;

                var chair   = !isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<BaseChair>()      : null;
                var trigger =  isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<UIPopupTrigger>() : null;
                var sCase   = !isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<SteamGameCase>()  : null;
                var dWasher = !isSitting ? tr.GameObject.Components.GetInAncestorsOrSelf<DishwasherWorkTrigger>() : null;

                if ( chair.IsValid() || trigger.IsValid() || sCase.IsValid() || dWasher.IsValid() )
                {
                    _hoveredCube      = null;
                    _foundChair       = chair;
                    _foundTrigger     = trigger;
                    _foundCase        = sCase;
                    _foundDishwasher  = dWasher;
                    _timeSinceLastHit = 0;
                }
            }
        }

        if ( _foundCase.IsValid() && IsVisible && Input.Pressed( "use" ) )
        {
            _foundCase.Shuffle();
        }

        if ( _timeSinceLastHit > 0.15f )
            ClearAll();

        SetClass( "visible", IsVisible );
    }

    private void ClearWorldObjects()
    {
        _foundChair      = null;
        _foundTrigger    = null;
        _foundCase       = null;
        _foundDishwasher = null;
    }

    private void ClearAll()
    {
        _hoveredCube = null;
        ClearWorldObjects();
    }

    Player Player => Player.FindLocalPlayer();

    protected override int BuildHash() => System.HashCode.Combine(
        _hoveredCube?.Id,
        _hoveredCube?.Value,
        WorldObject?.Id,
        IsVisible,
        CubeWarning,
        UIPopupTrigger.ActiveInstance.IsValid(),
        SinvestOS.Instance?.IsOpen ?? false
    );
}
