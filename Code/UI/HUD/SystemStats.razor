@using Sandbox;
@using Sandbox.UI;
@using Sinvest;
@using System;
@using System.Linq;

@* Inherit from Panel to allow this to be used as a tag <SystemStats /> *@
@inherits Panel
@namespace Sandbox

<root class="system-stats-tray">
    @* CASH SEGMENT *@
    <div class="stat-segment">
        <img src="ui/casino/navigation/sincash.png" class="mini-icon" />
        <div class="content">
            <span class="label">CASH</span>
            <span class="value">$@FormatCash(_displayMoney)</span>
        </div>
    </div>

    <div class="stat-divider"></div>

    @* SHARES SEGMENT *@
    <div class="stat-segment">
        <img src="ui/casino/navigation/fundino_icon.png" class="mini-icon" />
        <div class="content">
            <span class="label">SHARES</span>
            <div class="value-row">
               <span class="value">@FormatShares(_displayShares)</span>
               <span class="valuation">[$@FormatCash(_targetShares * GetSharePrice())]</span>
            </div>
        </div>
    </div>
</root>

@code {
    // Layout visual interpolators and targets over to type safe decimals
    private decimal _displayMoney = 0m;
    private decimal _targetMoney = 0m;
    private decimal _displayShares = 0m;
    private decimal _targetShares = 0m;
    private bool _initialized = false;

    protected override void OnAfterTreeRender(bool firstTime)
    {
        if (firstTime)
        {
            // Subscribe to the ledger changes
            GameSaveSystem.OnDataChanged += RefreshData;
            RefreshData();
        }
    }

    /// <summary>
    /// Pulls current character stats from the authoritative ledger.
    /// </summary>
    private void RefreshData()
    {
        var save = GameSaveSystem.Instance;
        if (!save.IsValid() || save.CurrentCharacter == null) return;

        _targetMoney = (decimal)save.CurrentCharacter.Money;
        _targetShares = (decimal)save.CurrentCharacter.Shares;

        if (!_initialized)
        {
            _displayMoney = _targetMoney;
            _displayShares = _targetShares;
            _initialized = true;
        }

        StateHasChanged();
    }

    public override void Tick()
    {
        bool needsUpdate = false;

        // Tightened threshold check down to 0.001m to allow smooth rolling decimals 
        // to complete their transitions down to 2 digits without trapping truncation frames.
        if (Math.Abs(_displayMoney - _targetMoney) > 0.001m)
        {
            // MathX.Lerp expects float parameters, so explicit float casts keep the layout interpolation clean.
            _displayMoney = (decimal)MathX.Lerp((float)_displayMoney, (float)_targetMoney, RealTime.Delta * 8.0f);
            needsUpdate = true;
        }
        else
        {
            _displayMoney = _targetMoney; // Snap cleanly to the exact target
        }

        if (Math.Abs(_displayShares - _targetShares) > 0.001m)
        {
            _displayShares = (decimal)MathX.Lerp((float)_displayShares, (float)_targetShares, RealTime.Delta * 8.0f);
            needsUpdate = true;
        }
        else
        {
            _displayShares = _targetShares; // Snap cleanly to the exact target
        }

        if (needsUpdate) StateHasChanged();
    }

    private decimal GetSharePrice() => (decimal)FundinoMarketService.CurrentPrice;

    /// <summary>
    /// Formats currency values cleanly to exactly two decimal places.
    /// </summary>
    private string FormatCash(decimal value)
    {
        decimal absValue = Math.Abs(value);
        if (absValue >= 1000000m)
           return (value / 1000000M).ToString("0.##") + "M";

        // "N2" guarantees exactly 2 decimal points for cash ($10.50)
        return value.ToString("N2");
    }

    /// <summary>
    /// Formats asset volumes to preserve full fractional precision without truncation bugs.
    /// </summary>
    private string FormatShares(decimal value)
    {
        decimal absValue = Math.Abs(value);
        if (absValue >= 1000000m)
           return (value / 1000000M).ToString("0.##") + "M";

        // "G" format removes trailing zeroes but preserves the full fractional 
        // precision (e.g., 1.5, 10.75, or 0.12345) dynamically as needed.
        return value.ToString("G");
    }

    // Cleanup reference on deletion
    public override void OnDeleted()
    {
        GameSaveSystem.OnDataChanged -= RefreshData;
        base.OnDeleted();
    }

    /// <summary>
    /// Ensures the UI refreshes if the share price changes externally.
    /// </summary>
    protected override int BuildHash() => System.HashCode.Combine(_targetMoney, _targetShares, GetSharePrice());
}
