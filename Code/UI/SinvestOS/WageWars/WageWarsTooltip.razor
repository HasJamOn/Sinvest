@using Sandbox; 
@using Sandbox.UI;
@using Sinvest;
@using System; 
@inherits PanelComponent
@namespace Sandbox

<root class="@(IsVisible ? "visible" : "")">
    @if ( _hoveredCube.IsValid() )
    {
       <div class="panel">
          <div class="header @(IsOwner || _hoveredCube.OwnerId == Guid.Empty ? "" : "hostile")">
             <i class="icon">@(IsOwner ? "layers" : "swords")</i>
             <div class="name">@(_hoveredCube.OwnerId == Guid.Empty ? "Unclaimed" : IsOwner ? "Your Territory" : "Hostile Tile")</div>
          </div>

          @if ( GetWarningText() is string warning )
          {
             <div class="description warning">@warning</div>
          }
          else
          {
             <div class="description">
                @(IsOwner ? $"Level {_hoveredCube.Value} Structure" : $"Grid Position: [{_hoveredCube.GridPosition.x}, {_hoveredCube.GridPosition.y}]")
             </div>
          }

          <div class="divider"></div>

          <div class="actions">
             @* Share Cost Indicator *@
             <div class="cost-info @(CanAfford ? "can-afford" : "too-expensive")">
                <i class="icon">rebase_edit</i>
                <span class="cost-text">Cost: 1 Share</span>
                @if (!CanAfford)
                {
                   <span class="balance-warning">(Need more shares)</span>
                }
             </div>

             <div class="action @(CanPerformAction() && CanAfford ? "" : "disabled")">
                <label class="key">@Input.GetButtonOrigin( "use" ).ToUpper()</label>
                <span class="text">@GetActionText()</span>
             </div>
          </div>
       </div>
    }
</root>

@code
{
    private WageWarsCube _hoveredCube;
    private TimeSince _timeSinceLastHit;
    private const int LaborCost = 1;

    bool IsVisible => _hoveredCube.IsValid() 
                      && _timeSinceLastHit < 0.1f 
                      && !(SinvestOS.Instance?.IsOpen ?? false);

    bool IsOwner 
    {
        get 
        {
           if ( !_hoveredCube.IsValid() ) return false;
           var myCharacter = Scene.GetAllComponents<WageWarsPlayer>().FirstOrDefault( p => !p.IsProxy );
           return myCharacter != null && _hoveredCube.OwnerId == myCharacter.GameObject.Id;
        }
    }

    /// <summary>
    /// Pulls live share data from the EconomyManager to check affordability.
    /// </summary>
    bool CanAfford
    {
        get
        {
            if (EconomyManager.Instance == null) return false;
            return EconomyManager.Instance.CurrentShares >= LaborCost;
        }
    }
    
    private string GetWarningText()
    {
        if ( !_hoveredCube.IsValid() ) return null;
        return IsOwner ? _hoveredCube.GetUpgradeRequirement() : _hoveredCube.GetAttackRequirement();
    }

    private bool CanPerformAction() => string.IsNullOrEmpty(GetWarningText());

    private string GetActionText()
    {
        if ( !_hoveredCube.IsValid() ) return "";
        if ( _hoveredCube.Value == 0 ) return "Claim Territory";
        return IsOwner ? "Upgrade Layer" : "Attack Structure";
    }

    protected override void OnUpdate()
    {
        if ( IsProxy ) return;

        var ray = Scene.Camera.ScreenNormalToRay( 0.5f );
        var tr = Scene.Trace.Ray( ray, 150f ).WithTag( "land" ).Run();

        if ( tr.Hit && tr.GameObject.IsValid() )
        {
            var cube = tr.GameObject.Components.GetInAncestorsOrSelf<WageWarsCube>();
            if ( cube.IsValid() )
            {
                _hoveredCube = cube;
                _timeSinceLastHit = 0;
            }
        }

        if ( _timeSinceLastHit > 0.15f ) _hoveredCube = null;

        SetClass( "visible", IsVisible );
    }

    // Hash includes CanAfford so the UI refreshes if the player gains/loses shares
    protected override int BuildHash() => System.HashCode.Combine( _hoveredCube?.Id, _hoveredCube?.Value, IsVisible, GetWarningText(), CanAfford );
}
