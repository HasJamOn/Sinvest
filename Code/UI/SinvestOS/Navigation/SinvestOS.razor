@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="stat-header">
		<div class="stat-box money">
			<img src="ui/casino/navigation/sincash.png" class="stat-icon" />
			<span class="label">CASH</span>
			<span class="value">$@_displayMoney.ToString("N0")</span>
		</div>
		<div class="stat-box shares">
			<img src="ui/casino/navigation/fundino_icon.png" class="stat-icon" />
			<span class="label">SHARES</span>
			<span class="value">@_displayShares.ToString("N0")</span>
		</div>
	</div>

    <div class="hud-content">
	    @if ( _activeViewPanel == null )
	    {
		    <div class="menu">
			    <button class="app-icon sincash" @onclick="@( () => SetView<CasinoMenu>() )">
				    <img src="ui/casino/navigation/sincash.png" />
				    <label>Sincash.ino</label>
			    </button>

			    <button class="app-icon" @onclick=@( () => SetView<InvestMenu>() )>
				    <img src="ui/casino/navigation/fundino_icon.png" />
				    <label>Fund.ino</label>
			    </button>

			    <button class="app-icon sincash" @onclick="@CloseAndDestroy">
				    <img src="ui/casino/navigation/sinvest.png" />
				    <label>Shutdown SinvestOS</label>
			    </button>
		    </div>
	    }
	    else 
	    {
		    @* LEAVE THIS EMPTY! 
              The C# AddChild will put the Flipper2D / CasinoMenu here.
           *@
           
		    @* By putting the button in its own conditional at the bottom, 
              we can force it to re-render after the child is added.
           *@
	    }

	    @if ( _activeViewPanel != null )
	    {
		    <button class="back-button" @onclick="@GoBack">
			    @if ( _history.Count > 0 )
			    {
				    <span>Back</span>
			    }
			    else
			    {
				    <span>Exit to Menu</span>
			    }
		    </button>
	    }
    </div>
</root>

@code
{
    public static SinvestOS Instance { get; private set; }
    private Panel _activeViewPanel;
    private Stack<Type> _history = new Stack<Type>();

    // --- State Variables ---
    private bool _isOpen = false;
    
    private double _displayMoney = 0;
    private double _targetMoney = 0;
    
    private double _displayShares = 0;
    private double _targetShares = 0;
    
    private bool _initialized = false;

    // Helper properties for sub-menus
    public double CurrentMoney => _targetMoney;
    public double CurrentShares => _targetShares;

    protected override void OnAwake() => Instance = this;
    
    public void CloseAndDestroy()
    {
	    var player = Scene.GetAllComponents<PlayerController>().FirstOrDefault(x => !x.IsProxy);
    
	    if ( player.IsValid() )
	    {
		    // 1. Identify the chair
		    var chair = player.GameObject.Parent?.Components.GetInAncestors<BaseChair>();
        
		    if ( chair.IsValid() )
		    {
			    // 2. Tell the chair to eject us normally
			    chair.AskToLeave( player );

			    // 3. FORCE RESTORE (The Safety Net)
			    // If the chair script fails to re-enable these, we do it here.
			    player.GameObject.SetParent( null ); // Ensure we aren't parented to the chair anymore
			    player.Body.Enabled = true;
			    player.ColliderObject.Enabled = true;
		    }

		    // 4. Restore Input
		    player.UseLookControls = true;
		    player.UseInputControls = true;
	    }

	    SetMenuState( false );
    
	    // 5. Cleanup
	    if ( Instance == this ) Instance = null;
	    GameObject.Root.Destroy();
    }
    
    protected override void OnDestroy()
    {
        if ( _isOpen ) SetMenuState( false );
        if ( Instance == this ) Instance = null;
    }
    
    protected override void OnUpdate()
    {
        if (!_initialized)
        {
           // Initial fetch from cloud stats
           var moneyStat = Sandbox.Services.Stats.LocalPlayer.Get("money");
           var sharesStat = Sandbox.Services.Stats.LocalPlayer.Get("fundino_shares");
       
           _targetMoney = moneyStat.Value;
           _displayMoney = _targetMoney; 

           _targetShares = sharesStat.Value;
           _displayShares = _targetShares;

           _initialized = true;
        }

        // --- Money Animation ---
        if ( Math.Abs(_displayMoney - _targetMoney) > 0.1 )
        {
           _displayMoney = MathX.Lerp( _displayMoney, _targetMoney, RealTime.Delta * 8.0f );
           StateHasChanged();
        }
        else if (_displayMoney != _targetMoney)
        {
           _displayMoney = _targetMoney;
           StateHasChanged();
        }

        // --- Shares Animation ---
        if ( Math.Abs(_displayShares - _targetShares) > 0.1 )
        {
           _displayShares = MathX.Lerp( _displayShares, _targetShares, RealTime.Delta * 8.0f );
           StateHasChanged();
        }
        else if (_displayShares != _targetShares)
        {
           _displayShares = _targetShares;
           StateHasChanged();
        }
    }

    public void Transaction(double moneyAmount, double sharesAmount = 0)
    {
	    _targetMoney += moneyAmount;
	    _targetShares += sharesAmount;

	    var eco = Scene.GetAllComponents<EconomyManager>().FirstOrDefault();
	    if (eco != null)
	    {
		    // Just call it directly
		    eco.CommitTransaction(moneyAmount, sharesAmount);
	    }
    }

    public void SetView<T>(bool saveToHistory = true) where T : Panel, new()
    {
        if (saveToHistory && _activeViewPanel != null)
        {
            _history.Push(_activeViewPanel.GetType());
        }

        CreateViewByType(typeof(T));
    }

    public void GoBack()
    {
        if (_history.Count > 0)
        {
           var previousType = _history.Pop();
           CreateViewByType(previousType);
        }
        else if (_activeViewPanel != null)
        {
           ClearView();
        }
        else
        {
           CloseAndDestroy();
        }
    }

    private void CreateViewByType(Type t)
    {
        _activeViewPanel?.Delete();
        
        var contentArea = Panel.Descendants.OfType<Panel>().FirstOrDefault(x => x.HasClass("hud-content"));
        if (contentArea == null) return;

        _activeViewPanel = t.Name switch
        {
            nameof(InvestMenu) => contentArea.AddChild<InvestMenu>(),
            nameof(CasinoMenu) => contentArea.AddChild<CasinoMenu>(),
            nameof(CoinFlip)   => contentArea.AddChild<CoinFlip>(),
            _ => null
        };

        StateHasChanged();
    }

    public void ClearView()
    {
        _activeViewPanel?.Delete();
        _activeViewPanel = null;
        _history.Clear();
        StateHasChanged();
    }

    public void Open() => SetMenuState(true);

    public void SetMenuState(bool open)
    {
        _isOpen = open;
        if (!open) ClearView();

        Panel.SetClass("hidden", !open);
        Mouse.Visibility = open ? MouseVisibility.Visible : MouseVisibility.Auto;
        
        var player = Scene.GetAllComponents<PlayerController>().FirstOrDefault(x => !x.IsProxy);
        if (player != null)
        {
            player.UseLookControls = !open;
            player.UseInputControls = !open;
            if (open) player.WishVelocity = Vector3.Zero;
        }
    }
    
    public void OpenInteraction<T>() where T : Panel, new()
    {
        _history.Clear(); 
        SetMenuState(true);
        CreateViewByType(typeof(T));
    }
}
