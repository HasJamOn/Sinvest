@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@inherits PanelComponent
@namespace Sandbox

<root class="@(_isOpen ? "" : "hidden")">
    <div class="hud">
       
          <div class="menu">
	          <button class="menu-button" @onclick="@(() => OnQuitClick())">
		          QUIT
	          </button>
          </div>

    </div>
</root>

@code
{
    private bool _isOpen = false;
    private PlayerController _cachedController;

    // ===== PUBLIC API (required for InteractComputer) =====
    public void Open()
    {
       SetMenuState(true);
    }

    public void Close()
    {
       SetMenuState(false);
    }

    public void Toggle()
    {
       SetMenuState(!_isOpen);
    }

    // ===== INTERNAL LOGIC =====
    private void OnQuitClick()
    {
	    Log.Info( "Quit button was physically pressed!" );
	    SetMenuState( false );
    }

    private void SetMenuState(bool open)
    {
	    _isOpen = open;

	    // 1. Visually show/hide
	    Panel.SetClass("hidden", !open);
       
	    // 2. Handle Mouse Lock and Visibility
	    Mouse.Visibility = open ? MouseVisibility.Visible : MouseVisibility.Auto;
       
	    // 3. IMPORTANT: Tell the UI to let the mouse interact with this panel
	    // This allows buttons to register @onclick events.
	    Panel.AcceptsFocus = open;
       
	    // Focus the panel so it starts receiving input immediately
	    if ( open ) Panel.Focus();

	    if (open && _cachedController == null)
		    _cachedController = Scene.GetAllComponents<PlayerController>().FirstOrDefault(x => !x.IsProxy);

	    if (_cachedController != null)
	    {
		    _cachedController.UseLookControls = !open;
		    _cachedController.UseInputControls = !open;

		    if (open)
		    {
			    _cachedController.WishVelocity = Vector3.Zero;
			    var body = _cachedController.Body;
			    if (body.IsValid())
			    {
				    body.Velocity = Vector3.Zero;
				    body.AngularVelocity = Vector3.Zero;
			    }
		    }
	    }
    }
}
