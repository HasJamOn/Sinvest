@using Sandbox; 
@using Sinvest;
@using Sandbox.UI;
@using System;
@using System.Threading.Tasks;

@inherits Panel

<root>
    <div class="cc-header">
        <label class="text-label">NEW CAREER: SLOT @SlotIndex</label>
        <label class="text-title">CREATE CHARACTER</label>
    </div>

    <div class="body column">
	    <div class="input-group">
		    <label class="input-label">LEGAL NAME</label>
		    <TextEntry Value:bind=@CharName placeholder="Enter name..." />
	    </div>

	    <div class="input-group">
		    <label class="input-label">STARTING MODIFIERS</label>
		    <div class="mod-list">
                @foreach ( StartingModifiers mod in Enum.GetValues( typeof( StartingModifiers ) ) )
                {
                    if ( mod == StartingModifiers.None ) continue;
                    var unlocked = SaveManager?.IsModifierUnlocked( mod ) ?? false;
                    var isActive = ActiveMods.HasFlag(mod);
                    
                    <div class="mod-row @(unlocked ? "" : "locked") @(isActive ? "active" : "")" onclick=@(() => ToggleMod(mod))>
                        <div class="column">
                            <label class="mod-name">@mod</label>
                            <label class="mod-status">@(unlocked ? "AVAILABLE" : "LOCKED")</label>
                        </div>
                        <div class="mod-checkbox @(isActive ? "active" : "")">
                            @if(isActive) { <label>✓</label> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="cc-footer">
        <div class="btn secondary @(IsProcessing ? "disabled" : "")" 
             onclick=@(() => { if(!IsProcessing) OnCancel?.Invoke(); })>
           ABORT
        </div>
    
        <div class="btn primary @(IsProcessing ? "processing" : "")" 
             onclick=@OnConfirm>
           @(IsProcessing ? "SYNCING..." : "START CAREER")
        </div>
    </div>
</root>

@code {
    [Property] public GameSaveSystem SaveManager { get; set; }
    [Property] public int SlotIndex { get; set; }
    public Action OnCancel { get; set; }
    [Property] public Func<string, StartingModifiers, Task> OnCreate { get; set; }

    string CharName = "";
    StartingModifiers ActiveMods = StartingModifiers.None;
    bool IsProcessing = false;
    
    protected override void OnParametersSet()
    {
       if ( SaveManager == null ) return;
       // Forced MentorDad if user hasn't graduated yet
       if ( !SaveManager.HasGraduated() ) ActiveMods |= StartingModifiers.MentorDad;
    }

    void ToggleMod( StartingModifiers mod ) 
    {
       if ( IsProcessing || SaveManager == null ) return; 
       if ( !SaveManager.IsModifierUnlocked( mod ) ) return;
       
       // Cannot remove MentorDad if it's forced by progression
       if ( mod == StartingModifiers.MentorDad && !SaveManager.HasGraduated() ) return; 

       if ( ActiveMods.HasFlag( mod ) ) ActiveMods &= ~mod;
       else ActiveMods |= mod;
    }

    async void OnConfirm() 
    {
	    if ( IsProcessing || string.IsNullOrWhiteSpace( CharName ) ) return;

	    IsProcessing = true;
	    StateHasChanged();

	    try 
	    {
		    if ( OnCreate != null )
		    {
			    // We await the parent's Task. 
			    // If the parent calls StartGame(), this will be cancelled.
			    await OnCreate.Invoke( CharName, ActiveMods );
		    }
	    }
	    catch ( Exception e ) when ( e is TaskCanceledException || e is OperationCanceledException )
	    {
		    // Scene changed, we don't need to reset IsProcessing because 
		    // this component is being deleted anyway.
		    Log.Info( "[UI] Character Creation cleaned up." );
	    }
	    catch ( Exception e )
	    {
		    Log.Error( $"[UI] Error: {e.Message}" );
		    // Only reset if we are still valid and didn't switch scenes
		    if ( this.IsValid() )
		    {
			    IsProcessing = false;
			    StateHasChanged();
		    }
	    }
    }
}
