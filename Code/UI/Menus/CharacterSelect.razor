@using Sandbox; 
@using Sinvest;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;

@inherits PanelComponent

<root>
	<div class="title">SINVEST</div>

	@if ( IsCreating ) {
		<CharacterCreator 
			SaveManager=@SaveManager 
			SlotIndex=@selectedSlot 
			OnCancel=@CancelCreation
			OnCreate=@CreateAndStart />
	}
	else {
		<div class="slot-container">
			@for ( int i = 1; i <= 3; i++ ) {
				var slotIndex = i;
				var charName = SaveManager?.GetStoredNameForSlot(slotIndex) ?? "Empty Slot";
				var isOccupied = IsSlotActive(slotIndex);

				<div class="slot-wrapper">
					<div class="slot-card @(isOccupied ? "occupied" : "")" onclick=@(() => OnSelectSlot(slotIndex))>
						<label class="slot-number">SLOT @slotIndex</label>
						<div class="char-name">@charName</div>
						<div class="select-hint">@(isOccupied ? "CONTINUE" : "CREATE NEW")</div>
					</div>

					@if ( isOccupied ) {
						<div class="delete-btn" onmousedown=@(() => StartDeleteTimer(slotIndex)) onmouseup=@StopDeleteTimer onmouseleave=@StopDeleteTimer>
							<label>@(DeletingSlot == slotIndex ? "REMOVING..." : "HOLD TO DELETE")</label>
							<div class="fill-bar" style="width: @((DeletingSlot == slotIndex ? DeleteProgress : 0).ToString())%;"></div>
						</div>
					}
				</div>
			}
		</div>
	}
</root>

@code {
    [Property] public GameSaveSystem SaveManager { get; set; }

    bool IsCreating = false;
    int selectedSlot = 1;
    
    // Delete Logic State
    int DeletingSlot = -1;
    float DeleteProgress = 0;
    const float DeleteTime = 1.5f;

    void OnSelectSlot( int index )
    {
        if ( SaveManager == null || DeletingSlot != -1 ) return;

        selectedSlot = index;
        SaveManager.ActiveSlot = index;
        SaveManager.LoadActiveSlot();
        
        // If the slot is empty, switch to the Creator view
        if ( SaveManager.CurrentCharacter.Name == "New Character" )
        {
           IsCreating = true;
        }
        else
        {
           StartGame();
        }
    }

    /// <summary>
    /// Explicit helper to handle the back/abort action from the CharacterCreator
    /// </summary>
    void CancelCreation()
    {
        IsCreating = false;
    }

    void StartDeleteTimer( int index ) => DeletingSlot = index;
    void StopDeleteTimer() { DeletingSlot = -1; DeleteProgress = 0; }

    protected override void OnUpdate()
    {
        if ( DeletingSlot != -1 )
        {
            DeleteProgress += (RealTime.Delta / DeleteTime) * 100f;

            if ( DeleteProgress >= 100 )
            {
                SaveManager?.DeleteSlot( DeletingSlot );
                StopDeleteTimer();
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Matches the Action<string, StartingModifiers> signature for the child component
    /// </summary>
    async void CreateAndStart( string name, StartingModifiers mods )
    {
	    if ( SaveManager == null ) return;

	    var charData = SaveManager.CurrentCharacter;
	    charData.Name = name;
	    charData.Modifiers = mods;
	    charData.Money = mods.HasFlag(StartingModifiers.DevMode) ? 999999999 : 0;

	    // This is where the 401 error happens. 
	    // We await it so the UI stays in the "Processing" state until it's done.
	    await SaveManager.SaveActiveSlotAsync();

	    IsCreating = false;
	    StartGame();
    }

    // Add this property so you can pick the scene in the Inspector
    [Property] public SceneFile WorldScene { get; set; }

    void StartGame()
    {
	    if ( WorldScene == null )
	    {
		    Log.Error( "WorldScene is not assigned in the Inspector!" );
		    return;
	    }

	    SceneNavigator.TransitionTo( WorldScene );
    }
    bool IsSlotActive( int index )
    {
	    if ( SaveManager == null ) return false;

	    var name = SaveManager.GetStoredNameForSlot( index );
    
	    // Peek at the "active" flag we just created, or the "money" stat
	    var isActive = SaveManager.GetStoredStatForSlot( index, "active" ) > 0;
	    var hasMoney = SaveManager.GetStoredStatForSlot( index, "money" ) > 0;

	    return (name != "New Character" && name != "Empty Slot") || isActive || hasMoney;
    }
}
