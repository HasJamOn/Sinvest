@using Sandbox; 
@using Sinvest;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Threading.Tasks;

@inherits PanelComponent

<root>
    <div class="vignette"></div>

    @if ( IsCreating ) {
       <CharacterCreator 
          SaveManager=@SaveManager 
          SlotIndex=@selectedSlot 
          OnCancel=@CancelCreation
          OnCreate=@CreateAndStart />
    }
    else {
       <div class="cs-header">
           <div class="main-logo">SINVEST</div>
           <div class="text-label">SELECT YOUR TIMELINE</div>
       </div>

       <div class="slot-container">
          @for ( int i = 1; i <= 3; i++ ) {
             var slotIndex = i;
             var charName = SaveManager?.GetStoredNameForSlot(slotIndex) ?? "Empty Slot";
             var isOccupied = IsSlotActive(slotIndex);

             <div class="slot-wrapper">
                <div class="slot-card @(isOccupied ? "occupied" : "")" onclick=@(() => OnSelectSlot(slotIndex))>
                   <div class="status-dot @(isOccupied ? "occupied" : "")"></div>
                   <div class="char-name">@charName</div>
                   <div class="select-hint">@(isOccupied ? "CONTINUE" : "CREATE NEW")</div>
                </div>

                @if ( isOccupied ) {
                   <div class="delete-strip" onmousedown=@(() => StartDeleteTimer(slotIndex)) onmouseup=@StopDeleteTimer onmouseleave=@StopDeleteTimer>
                      <label>@(DeletingSlot == slotIndex ? "REMOVING..." : "HOLD TO DELETE")</label>
                      <div class="fill-bar" style="width: @((DeletingSlot == slotIndex ? DeleteProgress : 0).ToString())%;"></div>
                   </div>
                }
             </div>
          }
       </div>
    }
</root>

@code {
    [Property] public GameSaveSystem SaveManager { get; set; }

    bool IsCreating = false;
    int selectedSlot = 1;
    
    int DeletingSlot = -1;
    float DeleteProgress = 0;
    const float DeleteTime = 1.5f;

    void OnSelectSlot( int index )
    {
        if ( SaveManager == null || DeletingSlot != -1 ) return;

        selectedSlot = index;
        SaveManager.ActiveSlot = index;
        SaveManager.LoadActiveSlot();
        
        if ( SaveManager.CurrentCharacter.Name == "New Character" )
        {
           IsCreating = true;
        }
        else
        {
           StartGame();
        }
    }

    void CancelCreation() => IsCreating = false;

    void StartDeleteTimer( int index ) => DeletingSlot = index;
    void StopDeleteTimer() { DeletingSlot = -1; DeleteProgress = 0; }

    protected override void OnUpdate()
    {
        if ( DeletingSlot != -1 )
        {
            DeleteProgress += (RealTime.Delta / DeleteTime) * 100f;

            if ( DeleteProgress >= 100 )
            {
                SaveManager?.DeleteSlot( DeletingSlot );
                StopDeleteTimer();
                StateHasChanged();
            }
        }
    }

    async Task CreateAndStart( string name, StartingModifiers mods )
    {
        if ( SaveManager == null ) return;

        var charData = SaveManager.CurrentCharacter;
        charData.Name = name;
        charData.Modifiers = mods;
        charData.Money = 0; 
        charData.Shares = 0;

        await SaveManager.SaveActiveSlotAsync();

        IsCreating = false;
        StateHasChanged();

        await Task.Delay( 100 );
        StartGame();
    }
    
    protected override void OnStart()
    {
        if ( SaveManager == null )
        {
           SaveManager = GameSaveSystem.Instance;
        }
    }

    void StartGame() => SaveManager?.StartGame();

    bool IsSlotActive( int index )
    {
        if ( SaveManager == null ) return false;
        var name = SaveManager.GetStoredNameForSlot( index );
        var hasMeta = SaveManager.GetStoredStatForSlot( index, "active" ) > 0;
        return name != "Empty Slot" && hasMeta;
    }
}
