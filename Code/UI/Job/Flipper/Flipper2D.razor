@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	<div class="flipper-container">
	<h1>2D Flipper</h1>
	
		<div class="game-canvas">
			<div class="paddle" style="left: @(PaddlePos.x / 800f * 100)%; top: @(PaddlePos.y / 600f * 100)%; width: @(PanWidth / 800f * 100)%;"></div>
			<label>GAME AREA: 800x600</label>
		</div>
	</div>
</root>

@code {
	// Section 4A: Equipment Variables
	private float PanWidth = 150f;
	private Vector2 PaddlePos = new Vector2( 400f, 400f );
	private float PanRotation = 0f;

	// Boundaries (relative to the game-canvas)
	private float MinY = 450f; // 600 - 150
	private float MaxY = 550f; // 600 - 50

	protected override void OnMouseMove(MousePanelEvent e)
	{
		base.OnMouseMove(e);

		var canvas = Children.SelectMany( x => x.Children ).FirstOrDefault( x => x.HasClass( "game-canvas" ) );
		if ( canvas == null || canvas.Box.Rect.Width == 0 ) return;

		float fractionX = canvas.MousePosition.x / canvas.Box.Rect.Width;
		float fractionY = canvas.MousePosition.y / canvas.Box.Rect.Height;

		float logicalX = fractionX * 800f;
		float logicalY = fractionY * 600f;

		float halfWidth = PanWidth / 2f;
        
		PaddlePos.x = logicalX.Clamp( halfWidth, 800f - halfWidth );

		// 2. New Action Zone: Clamped between 350 and 450
		// This keeps the paddle in the bottom third but leaves ~150px of plate space below
		PaddlePos.y = logicalY.Clamp( 350f, 450f );

		StateHasChanged();
	}

	// Helper to convert screen pixels to UI units
	private Vector2 ScreenToLocal(Vector2 screenPos) => MousePosition; 
}
