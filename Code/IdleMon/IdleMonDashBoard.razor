@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;

@namespace Sinvest

@inherits PanelComponent

<root>
    @if ( Roster == null )
    {
        <div class="error">MISSING ROSTER_MANAGER REFERENCE</div>
    }
    else
    {
        <div class="header">
            <div class="app-identity">
                <label class="label">IDLEMON.ino</label>
                <div class="sync-status @(Roster.IsDirty ? "pending" : "synced")">
                    <div class="indicator"></div>
                    <label>@(Roster.IsDirty ? "SYNC PENDING" : "DATA SECURED")</label>
                </div>
            </div>
    
            <div class="stats-group">
                <div class="currency-block">
                    <label class="label">TOTAL ASSETS</label>
                    <label class="value">@Roster.IdleBucks.ToString("F2") IB</label>
                </div>
                <div class="yield-block">
                    <label class="label">CURRENT YIELD</label>
                    <label class="value positive">@Roster.CalculateTotalYield().ToString("F2") IB/s</label>
                </div>
            </div>

            <button class="btn-terminate" onclick="@ExitIdleMon">
                <i class="icon">power_settings_new</i>
                <span>EXIT</span>
            </button>
        </div>

        <div class="dashboard-body">
            @* --- LEFT COLUMN: THE GRID --- *@
            <div class="node-matrix">
                @for ( int i = 0; i < 6; i += 2 )
                {
                    <div class="matrix-row">
                        @for ( int j = 0; j < 2; j++ )
                        {
                            var index = i + j;
                            var mon = (Roster.ActiveNodes != null && index < Roster.ActiveNodes.Count) 
                                ? Roster.ActiveNodes[index] 
                                : IdleMonData.Empty;

                            bool isEmpty = mon.ID == Guid.Empty;
                            bool isSelected = SelectedSlotIndex == index;

                            <div class="node-card @(isEmpty ? "empty" : "active") @(isSelected ? "selected" : "")" 
                                 onclick="@(() => OnNodeClick(index))">
    
                                @if ( !isEmpty )
                                {
                                    <div class="portrait-viewport">
                                      @if(index == 0) { <IdleMonDisplay @ref="Display0" style="width: 100%; height: 100%; min-width: 85px; min-height: 85px;" /> }
                                      else if(index == 1) { <IdleMonDisplay @ref="Display1" style="width: 100%; height: 100%; min-width: 85px; min-height: 85px;" /> }
                                      else if(index == 2) { <IdleMonDisplay @ref="Display2" style="width: 100%; height: 100%; min-width: 85px; min-height: 85px;" /> }
                                      else if(index == 3) { <IdleMonDisplay @ref="Display3" style="width: 100%; height: 100%; min-width: 85px; min-height: 85px;" /> }
                                      else if(index == 4) { <IdleMonDisplay @ref="Display4" style="width: 100%; height: 100%; min-width: 85px; min-height: 85px;" /> }
                                      else if(index == 5) { <IdleMonDisplay @ref="Display5" style="width: 100%; height: 100%; min-width: 85px; min-height: 85px;" /> }
                                   </div>
                                   
                                   <div class="card-info">
	                                   <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
		                                   <span class="name">@mon.Name</span>
		                                   <span class="gen-tag">G@(mon.Generation)</span>
	                                   </div>
	                                   
	                                   <div class="card-stats">
		                                   @RenderStats(mon)
	                                   </div>

                                      <div class="card-footer">
                                         @if ( IsDrafting && CurrentDeltas != null && index < CurrentDeltas.Length )
                                         {
                                            var d = CurrentDeltas[index];
                                            <span class="yield-delta @(d >= 0 ? "pos" : "neg")">
                                               @(d >= 0 ? "+" : "")@d.ToString("F2") IB/s
                                            </span>
                                         }
                                         else
                                         {
                                            <span class="status-tag">ACTIVE</span>
                                         }
                                      </div>
                                   </div>
                                }
                                else
                                {
                                   <div class="empty-state">
                                      <i class="icon">@(IsDrafting ? "publish" : "add")</i>
                                   </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* --- RIGHT COLUMN: THE INSPECTOR --- *@
            <div class="inspector-panel">
                @if ( SelectedSlotIndex.HasValue )
                {
                    var selectedMon = Roster.ActiveNodes[SelectedSlotIndex.Value];
                    bool isEmpty = selectedMon.ID == Guid.Empty;

                    <div class="inspector-content">
                        <div class="inspector-header">
                            @if (!isEmpty)
                            {
                                <div class="inspector-portrait">
                                    <IdleMonDisplay @ref="InspectorDisplay" style="width: 100%; height: 100%;" />
                                </div>
                                
                                <div class="performance-data">
	                                <div class="perf-header">
		                                <label>PERFORMANCE DATA</label>
		                                <label>DATE @DateTime.Now.ToString("dd/MM/yyyy") - GENERATION: @selectedMon.Generation</label>
	                                </div>
	                                @RenderStats(selectedMon)
                                </div>
                            }
                        </div>

                        <div class="inspector-identity">
                            <label class="subtitle">SLOT @(SelectedSlotIndex.Value + 1)</label>
                            <h1 class="title">@(isEmpty ? "VACANT SLOT" : selectedMon.Name)</h1>
                        </div>

                        @if ( !isEmpty )
                        {

                            <button class="btn-purge" onclick="@(() => PurgeNode(SelectedSlotIndex.Value))">
                                <i class="icon">delete_forever</i>
                                <span>PURGE ASSET</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="inspector-placeholder">
                        <label>SELECT A NODE TO VIEW DATA</label>
                    </div>
                }
            </div> </div> <div class="footer">
            @if ( !IsDrafting )
            {
                <button class="btn-primary" onclick="@StartDraft">ACQUIRE ASSET (ROLL)</button>
            }
            else
            {
                <div class="draft-comparison-stage">
                    <div class="current-slot">
                        @if ( SelectedSlotIndex.HasValue )
                        {
                            var currentMon = Roster.ActiveNodes[SelectedSlotIndex.Value];
                            <div class="node-card comparison-card current-target expanded">
                                <div class="comparison-badge badge-current">CURRENT ASSET</div>
                                <div class="comparison-portrait">
                                   <IdleMonDisplay @ref="ComparisonCurrentDisplay" style="width: 100%; height: 100%;" />
                                </div>
                                <div class="card-header">
                                   <span class="name">@currentMon.Name</span>
                                </div>
                                <div class="card-body">
                                   @RenderStats(currentMon)
                                </div>
                            </div>
                        }
                    </div>

                    <div class="comparison-vs">
                        <i class="icon">swap_horiz</i>
                        <span>VS</span>
                    </div>

                    <div class="candidate-slot">
                        <div class="node-card comparison-card candidate-new expanded">
                           <div class="comparison-badge badge-candidate">NEW CANDIDATE</div>
                           <div class="comparison-candidate-portrait">
                              <IdleMonDisplay @ref="ComparisonCandidateDisplay" style="width: 100%; height: 100%;" />
                           </div>
                           <div class="card-header">
                              <div class="name-group">
                                 <span class="name">@DraftCandidate?.Name</span>
                              </div>
                              <span class="gen-tag">GEN @DraftCandidate?.Generation</span>
                           </div>

                           <div class="card-body">
                              @if (DraftCandidate.HasValue) 
                              {
                                 @RenderStats(DraftCandidate.Value)
                              }
                           </div>

                           <div class="card-footer">
                              @if ( SelectedSlotIndex.HasValue && CurrentDeltas != null )
                              {
                                 var delta = CurrentDeltas[SelectedSlotIndex.Value];
                                 <span class="yield-contribution @(delta >= 0 ? "positive" : "negative")">
                                    @(delta >= 0 ? "+" : "")@delta.ToString("F2") IB/s Impact
                                 </span>
                              }
                              else
                              {
                                 <span class="instruction-dimmed">SELECT SLOT TO CALCULATE</span>
                              }
                           </div>
                        </div>
                    </div>

                    <div class="draft-actions">
                        @if ( SelectedSlotIndex.HasValue )
                        {
                            var delta = CurrentDeltas[SelectedSlotIndex.Value];
                            
                            <button class="btn-primary @(delta < 0 ? "warning-btn" : "confirm-btn")" 
                                    onclick="@(() => ConfirmSwap(SelectedSlotIndex.Value))">
                                <i class="icon">@(delta < 0 ? "warning" : "check_circle")</i>
                                <span>@(delta < 0 ? "FORCE OVERWRITE" : "CONFIRM INSTALL")</span>
                            </button>
                            
                            <div class="delta-preview @(delta >= 0 ? "positive" : "negative")">
                                <label>PROJECTED CHANGE</label>
                                <span>@(delta >= 0 ? "+" : "")@delta.ToString("F2") IB/s</span>
                            </div>
                        }
                        else
                        {
                            <div class="instruction-block">
                                <i class="icon">mouse</i>
                                <label>SELECT A GRID NODE TO COMPARE</label>
                            </div>
                        }
                        <button class="btn-discard" onclick="@CancelDraft">ABANDON ROLL</button>
                    </div>
                </div>
            }
        </div>
    }
</root>

@code {
    [Property] public GameObject IdleMonSystem { get; set; }
    [Property] public RosterManager Roster { get; set; }
    [Property] public AssetGenerator Generator { get; set; }
    
    private bool IsDrafting => DraftCandidate.HasValue;
    private IdleMonData? DraftCandidate = null;
    private double[] CurrentDeltas;
    private int? SelectedSlotIndex = null; 
    
    // Explicit properties bypass the compiler array-indexer crash
    private IdleMonDisplay Display0;
    private IdleMonDisplay Display1;
    private IdleMonDisplay Display2;
    private IdleMonDisplay Display3;
    private IdleMonDisplay Display4;
    private IdleMonDisplay Display5;

    private IdleMonDisplay InspectorDisplay;
    private IdleMonDisplay ComparisonCurrentDisplay;
    private IdleMonDisplay ComparisonCandidateDisplay;

    protected override void OnEnabled()
    {
       if ( Roster == null ) 
          Roster = Scene.GetAllComponents<RosterManager>().FirstOrDefault();
    
       if ( Generator == null )
          Generator = Scene.GetAllComponents<AssetGenerator>().FirstOrDefault();

       if (CurrentDeltas == null || CurrentDeltas.Length != 6) 
          CurrentDeltas = new double[6];
       
       if ( Panel.IsValid() )
       {
          Panel.Style.PointerEvents = PointerEvents.All;
          Panel.AcceptsFocus = true; 
          Panel.Focus();
       }
    }

    protected override void OnTreeBuilt()
    {
       if ( Roster?.ActiveNodes == null ) return;

       // Group the references dynamically at runtime instead of compile-time
       var gridDisplays = new[] { Display0, Display1, Display2, Display3, Display4, Display5 };
       int count = Math.Min(gridDisplays.Length, Roster.ActiveNodes.Count);

       for ( int i = 0; i < count; i++ )
       {
          var display = gridDisplays[i];
          if ( display == null ) continue; 

          var mon = Roster.ActiveNodes[i];
          if ( mon.ID != Guid.Empty )
          {
             display.SetModel( mon.ModelPath );
             display.UpdateStats( mon, mon.SteamId ); 
          }
       }

       // 2. REFRESH THE INSPECTOR PORTRAIT
       if (SelectedSlotIndex.HasValue && InspectorDisplay != null)
       {
          var mon = Roster.ActiveNodes[SelectedSlotIndex.Value];
          if (mon.ID != Guid.Empty)
          {
             InspectorDisplay.SetModel(mon.ModelPath);
             InspectorDisplay.UpdateStats(mon, mon.SteamId);
          }
       }

       // 3. REFRESH THE COMPARISON PORTRAITS
       if (IsDrafting)
       {
          if (SelectedSlotIndex.HasValue && ComparisonCurrentDisplay != null)
          {
             var cur = Roster.ActiveNodes[SelectedSlotIndex.Value];
             if (cur.ID != Guid.Empty)
             {
                ComparisonCurrentDisplay.SetModel(cur.ModelPath);
                ComparisonCurrentDisplay.UpdateStats(cur, cur.SteamId);
             }
          }

          if (ComparisonCandidateDisplay != null && DraftCandidate.HasValue)
          {
             ComparisonCandidateDisplay.SetModel(DraftCandidate.Value.ModelPath);
             ComparisonCandidateDisplay.UpdateStats(DraftCandidate.Value, DraftCandidate.Value.SteamId);
          }
       }
    }

    RenderFragment RenderStats(IdleMonData data) => __builder => {
    if (data.ID == Guid.Empty) {
        <div class="empty-stats-msg">
            <i class="icon">sensors_off</i>
            <span>NO DATA DETECTED</span>
        </div>
        return;
    }

    <div class="stats-container">
        @* --- PRIMARY METRICS --- *@
        <div class="stats-section">
            <div class="section-label">PRIMARY CALCULATIONS</div>
            <div class="stats-grid">
                @RenderStatItem("add_circle", "ADDITION", data.Addition.ToString("F1"), "positive")
                @RenderStatItem("close", "MULTIPLIER", $"x{data.Multiplier:F1}", "positive")
                @RenderStatItem("groups", "TEAM BONUS", $"+{(data.TeamBonus * 100 - 100):0}%", "synergy")
            </div>
        </div>

        @* --- OPERATIONAL DRAG --- *@
        <div class="stats-section">
            <div class="section-label">SYSTEM OVERHEAD</div>
            <div class="stats-grid">
                @RenderStatItem("remove_circle", "SUBTRACTION", $"-{data.Subtraction:F1}", "negative")
                @RenderStatItem("horizontal_rule", "DIVISION", $"/{data.Division:F1}", "negative")
            </div>
        </div>

        @* --- UTILITY & SYNERGY --- *@
        <div class="stats-section">
            <div class="section-label">UTILITY PARAMETERS</div>
            <div class="stats-grid">
                @RenderStatItem("bolt", "EFFICIENCY", data.CostEfficiency.ToString("F1"), "utility")
                @RenderStatItem("auto_fix_high", "LUCK", data.Luck.ToString("F1"), "utility")
                
                @{
                    bool active = data.TeamBonus > 1.0;
                    @RenderStatItem(active ? "sync" : "sync_disabled", "SYNERGY", active ? "STABLE" : "OFFLINE", active ? "synergy-active" : "synergy-dim")
                }
            </div>
        </div>
    </div>
};

    protected override int BuildHash() => System.HashCode.Combine( 
        Roster?.IdleBucks ?? 0, 
        Roster?.ActiveNodes?.Count ?? 0,
        IsDrafting, 
        DraftCandidate?.ID ?? Guid.Empty,
        SelectedSlotIndex ?? -1
    );
    
    private void PurgeNode(int index) => Roster?.SwapNode(index, IdleMonData.Empty);

    public void StartDraft()
    {
        if ( Generator == null || Roster == null ) return;
        SelectedSlotIndex = null;
        DraftCandidate = Generator.RollNewAsset();
        CurrentDeltas = Roster.GetSwapDeltas( DraftCandidate.Value );
    }

    private void CancelDraft()
    {
        DraftCandidate = null;
        CurrentDeltas = null;
    }

    private void ConfirmSwap( int slotIndex )
    {
        if ( !DraftCandidate.HasValue || Roster == null ) return;
        Roster.SwapNode( slotIndex, DraftCandidate.Value );
        CancelDraft();
    }

    private void OnNodeClick( int index )
    {
        SelectedSlotIndex = (SelectedSlotIndex == index) ? null : index;
    }
    
    private void ExitIdleMon()
    {
        var player = Scene.GetAllComponents<PlayerController>().FirstOrDefault(x => !x.IsProxy);
        if ( player.IsValid() )
        {
           player.UseLookControls = true;
           player.UseInputControls = true;
        }

        Roster?.SaveRoster();
        CancelDraft();
        SelectedSlotIndex = null;

        if (SinvestOS.Instance != null)
        {
           SinvestOS.Instance.GoBack();
        }
    }
    RenderFragment RenderStatItem(string icon, string label, string value, string cssClass) => __builder => {
	    <div class="stat-item @cssClass">
		    <div class="stat-icon-wrapper">
			    <i class="icon">@icon</i>
		    </div>
		    <div class="stat-details">
			    <span class="stat-value">@value</span>
		    </div>
	    </div>
    };
}
